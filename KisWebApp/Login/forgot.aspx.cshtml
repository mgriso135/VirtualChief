@{
    ViewBag.Title = "Password Dimenticata";
    Layout = "~/Site.cshtml";
}

<div class="container-fluid">
    <h1>Password Dimenticata</h1>
    <p>Inserisci il tuo indirizzo email per ricevere un link di reimpostazione della password.</p>
    <div class="row">
        <div class="col-md-6">
            <form class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-sm-4" for="email">Email:</label>
                    <div class="col-sm-8">
                        <input type="email" class="form-control" id="email" placeholder="name@esempio.com" />
                    </div>
                </div>
                <div class="form-group">
                    <div class="col-sm-offset-4 col-sm-8">
                        <button type="submit" class="btn btn-link">Invia richieste</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
