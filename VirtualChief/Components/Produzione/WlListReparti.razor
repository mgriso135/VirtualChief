@using KIS.App_Code
@using KIS.App_Sources
@using Microsoft.AspNetCore.Components
@inject ILogger<WlListReparti> Logger
@inject NavigationManager NavigationManager

@if (!HasPermission)
{
    <div class="alert alert-warning">@PermissionDeniedMessage</div>
}
else if (Reparti == null || Reparti.Count == 0)
{
    <div class="alert alert-info">@NoRepartiMessage</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th></th>
                <th>@RepartoLabel</th>
                <th>@DescrizioneLabel</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var reparto in Reparti)
            {
                <tr>
                    <td>
                        <a href="@($"/Produzione/WorkLoadSimReparti?id={reparto.id}")" title="@ViewSimulationTooltip">
                            <img src="/img/iconLabor.png" height="30px" />
                        </a>
                    </td>
                    <td>@reparto.name</td>
                    <td>@reparto.description</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Parameter]
    public string Tenant { get; set; }

    [Parameter]
    public bool HasPermission { get; set; } = false;

    [Parameter]
    public List<Reparto> Reparti { get; set; } = new();

    public string RepartoLabel { get; set; } = "Reparto";
    public string DescrizioneLabel { get; set; } = "Descrizione";
    public string ViewSimulationTooltip { get; set; } = "Visualizza simulazione";
    public string PermissionDeniedMessage { get; set; } = "Non hai il permesso di visualizzare i reparti";
    public string NoRepartiMessage { get; set; } = "Nessun reparto configurato";

    protected override void OnInitialized()
    {
        LoadResources();
    }

    private void LoadResources()
    {
        RepartoLabel = "Reparto";
        DescrizioneLabel = "Descrizione";
        ViewSimulationTooltip = "Visualizza simulazione";
        PermissionDeniedMessage = "Non hai il permesso di visualizzare i reparti";
        NoRepartiMessage = "Nessun reparto configurato";
    }
}