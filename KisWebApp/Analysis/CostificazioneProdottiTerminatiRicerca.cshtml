                <th><label id="lblTHCommessa" /></th>
                <th><label id="lblTHCliente" /></th>
                <th><label id="lblTHArticolo" /></th>
                <th><label id="lblTHMatricola" /></th>
                <th><label id="lblTHProcesso" /></th>
                <th><label id="lblTHQuantita" /></th>
                <th><label id="lblTHReparto" /></th>
                <th><label id="lblTHDataFine" /></th>
                <th><label id="lblTHDataConsegna" /></th>
                <th><label id="lblTHTempoLavoro" /></th>
            </tr>
        </thead>
        <tbody>
            <!-- Articoli terminati -->
        </tbody>
    </table>
</div>

<script type="text/javascript">
    function doSearch() { alert("Ricerca effettuata"); }
