@inherits KIS.Eventi.CommessaRitardo
@{
    // placeholder – markup reproduced from CommessaRitardo.ascx
}
<h3><img src="~/img/iconEmail.png" height="50" id="imgTitle" />
    <label id="lblTitleCfgDelay" /></h3>
<label id="lbl1" />
<label id="lblSegnalaMaggioreDi" />&nbsp;
<label id="lblOre" />:
<select id="ddlOre" class="dropdown" style="width:70px;"><option>00</option></select>&nbsp;
mm:<select id="ddlMinuti" class="dropdown" style="width:60px;"><option>00</option></select>&nbsp;
ss:<select id="ddlSecondi" class="dropdown" style="width:60px;"><option>00</option></select>
<button type="button" id="btnSaveRitMin" class="btn btn-success">Salva</button>
<button type="button" id="btnUndoRitMin" class="btn">Annulla</button>

<table class="table table-striped table-condensed table-hover">
    <tbody>
        <tr>
            <td>
                <h5><label id="lblGruppiSegnala" /></h5>
                <button type="button" id="btnShowAddRitardoGruppo" class="btn-link">+</button>
                <label id="lblGruppiAdd" />
                <table id="frmAddRitardoGruppo" style="display:none;" class="table table-condensed">
                    <tr>
                        <td><label id="lblGruppiSel" />:</td>
                        <td><select id="ddlAddRitardoGruppo"><option value="">--</option></select></td>
                        <td>
                            <button type="button" id="btnSaveRitardoGruppo" class="btn btn-success">Salva</button>
                            <button type="button" id="btnUndoRitardoGruppo" class="btn">Annulla</button>
                        </td>
                    </tr>
                </table>
                <table class="table table-striped table-condensed table-hover">
                    <tbody>
                        <!-- Items generated by code‑behind / AJAX -->
                    </tbody>
                </table>
            </td>
            <td>
                <h5><label id="lblUtentiList" /></h5>
                <button type="button" id="btnShowAddRitardoUtente" class="btn-link">+</button>
                <label id="lblUtentiAdd" />
                <table id="frmAddRitardoUtente" style="display:none;" class="table table-condensed">
                    <tbody>
                        <tr>
                            <td><label id="lblUtentiSel" />:</td>
                            <td><select id="ddlAddRitardoUtente"><option value="">--</option></select></td>
                            <td>
                                <button type="button" id="btnSaveRitardoUtente" class="btn btn-success">Salva</button>
                                <button type="button" id="btnUndoRitardoUtente" class="btn">Annulla</button>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <table>
                    <!-- Items generated by code‑behind / AJAX -->
                </table>
            </td>
        </tr>
    </tbody>
</table>

<script type="text/javascript">
    $(function () {
        $("#btnShowAddRitardoGruppo").click(function () { $("#frmAddRitardoGruppo").toggle(); });
        $("#btnShowAddRitardoUtente").click(function () { $("#frmAddRitardoUtente").toggle(); });
        $("#btnSaveRitMin").click(function () { alert("Soglia ritardo salvata"); });
        $("#btnSaveRitardoGruppo").click(function () { alert("Gruppo aggiunto"); });
        $("#btnSaveRitardoUtente").click(function () { alert("Utente aggiunto"); });
    });
</script>