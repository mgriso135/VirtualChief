@page "/Reparti/ElencoFestivita"
@model VirtualChief.Pages.Reparti.ElencoFestivitaModel
@{
    ViewData["Title"] = "Elenco Festività";
}

<div class="container">
    <nav aria-label="breadcrumb" class="mt-3 mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="/Reparti/listReparti">@Model.NavReparti</a>
            </li>
            <li class="breadcrumb-item">
                <a href="/Reparti/ConfigTurni?id=@Model.TurnoId">@Model.NavConfigTurni</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">@Model.NavElencoFestivita</li>
        </ol>
    </nav>

    <h1>@Model.NavElencoFestivita</h1>

    <div class="card">
        <div class="card-body">
            <component type="typeof(Components.Reparti.ElencoFestivita)" 
                       param-Tenant="@Model.Tenant"
                       param-HasPermission="@Model.HasPermission"
                       param-TurnoId="@Model.TurnoId"
                       render-mode="ServerPrerendered" />
             
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger mt-3">@Model.ErrorMessage</div>
            }
        </div>
    </div>
</div>