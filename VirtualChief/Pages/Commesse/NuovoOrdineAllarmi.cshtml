@page
@model VirtualChief.Pages.Commesse.NuovoOrdineAllarmiModel
@{
    ViewData["Title"] = "Imposta Allarmi";
}

<div class="container">
    <nav aria-label="breadcrumb" class="mt-3 mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="/Commesse/commesse">@Model.NavCommesse</a>
            </li>
            <li class="breadcrumb-item">
                <a href="/Commesse/NuovoOrdine">@Model.NavNuovoOrdine</a>
            </li>
            <li class="breadcrumb-item">
                <a href="/Commesse/NuovoOrdineProdotti?idCommessa=@Model.IdCommessa&annoCommessa=@Model.AnnoCommessa">@Model.NavProdotti</a>
            </li>
            <li class="breadcrumb-item">
                <a href="/Commesse/NuovoOrdineReparto?idCommessa=@Model.IdCommessa&annoCommessa=@Model.AnnoCommessa&idProdotto=@Model.IdProdotto&annoProdotto=@Model.AnnoProdotto">@Model.NavReparto</a>
            </li>
            <li class="breadcrumb-item">
                <a href="/Commesse/NuovoOrdineTasks?idCommessa=@Model.IdCommessa&annoCommessa=@Model.AnnoCommessa&idProdotto=@Model.IdProdotto&annoProdotto=@Model.AnnoProdotto">@Model.NavTasks</a>
            </li>
            <li class="breadcrumb-item">
                <a href="/Commesse/NuovoOrdineDataConsegna?idCommessa=@Model.IdCommessa&annoCommessa=@Model.AnnoCommessa&idProc=@Model.IdProc&revProc=@Model.RevProc&idVariante=@Model.IdVariante&idReparto=@Model.IdReparto&idProdotto=@Model.IdProdotto&annoProdotto=@Model.AnnoProdotto&quantita=@Model.Quantita">@Model.NavDataConsegna</a>
            </li>
            <li class="breadcrumb-item">
                <a href="/Commesse/NuovoOrdineCaricoLavoro?idCommessa=@Model.IdCommessa&annoCommessa=@Model.AnnoCommessa&idProc=@Model.IdProc&revProc=@Model.RevProc&idVariante=@Model.IdVariante&idReparto=@Model.IdReparto&idProdotto=@Model.IdProdotto&annoProdotto=@Model.AnnoProdotto&quantita=@Model.Quantita">@Model.NavCaricoLavoro</a>
            </li>
            <li class="breadcrumb-item">
                <a href="/Commesse/NuovoOrdineDataFineProduzione?idCommessa=@Model.IdCommessa&annoCommessa=@Model.AnnoCommessa&idProc=@Model.IdProc&revProc=@Model.RevProc&idVariante=@Model.IdVariante&idReparto=@Model.IdReparto&idProdotto=@Model.IdProdotto&annoProdotto=@Model.AnnoProdotto&quantita=@Model.Quantita">@Model.NavDataFineProduzione</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">@Model.NavAllarmi</li>
        </ol>
    </nav>

    <h1>@Model.NavAllarmi</h1>

    @if (!Model.HasPermission)
    {
        <div class="alert alert-warning">@Model.PermissionDeniedMessage</div>
    }
    else if (Model.Articolo == null)
    {
        <div class="alert alert-danger">Articolo non trovato.</div>
    }
    else
    {
        <div class="card mb-3">
            <div class="card-header">
                <h5>@Model.InfoPanelTitle</h5>
            </div>
            <div class="card-body">
                <component type="typeof(Components.Commesse.WizardInfoPanel)" 
                           param-Tenant="@Model.Tenant"
                           param-IdCommessa="@Model.IdCommessa"
                           param-AnnoCommessa="@Model.AnnoCommessa"
                           param-IdProc="@Model.IdProc"
                           param-RevProc="@Model.RevProc"
                           param-IdVariante="@Model.IdVariante"
                           param-IdProdotto="@Model.IdProdotto"
                           param-AnnoProdotto="@Model.AnnoProdotto"
                           param-IdReparto="@Model.IdReparto"
                           render-mode="ServerPrerendered" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4>@Model.AlarmsTitle</h4>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-primary btn-sm" onclick="toggleAlarms()">
                            @(Model.ShowAlarms ? Model.HideAlarmsLabel : Model.ShowAlarmsLabel)
                        </button>
                        <a href="@Model.NewProductUrl" class="btn btn-primary btn-sm">
                            <img src="/img/iconProductionPlan.png" height="40" />
                            <span class="ms-2">@Model.NewProductLabel</span>
                        </a>
                    </div>
                </div>

                <div id="alarmsPanel" style="@(Model.ShowAlarms ? "" : "display:none;")">
                    <div class="row">
                        <div class="col-md-6">
                            <component type="typeof(Components.Eventi.ArticoloRitardoConfig)" 
                                       param-Tenant="@Model.Tenant"
                                       param-ArticoloId="@Model.IdProdotto"
                                       param-ArticoloAnno="@Model.AnnoProdotto"
                                       param-HasPermission="@Model.CanConfigDelay"
                                       render-mode="ServerPrerendered" />
                        </div>
                        <div class="col-md-6">
                            <component type="typeof(Components.Eventi.ArticoloWarningConfig)" 
                                       param-Tenant="@Model.Tenant"
                                       param-ArticoloId="@Model.IdProdotto"
                                       param-ArticoloAnno="@Model.AnnoProdotto"
                                       param-HasPermission="@Model.CanConfigWarning"
                                       render-mode="ServerPrerendered" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-4">
            <a href="@Model.BackUrl" class="btn btn-secondary">
                <img src="/img/iconArrowLeft.png" height="20" /> @Model.BackLabel
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        function toggleAlarms() {
            const panel = document.getElementById('alarmsPanel');
            const btn = document.querySelector('button[onclick="toggleAlarms()"]');
            if (panel && btn) {
                if (panel.style.display === 'none') {
                    panel.style.display = 'block';
                    btn.textContent = '@Model.HideAlarmsLabel';
                } else {
                    panel.style.display = 'none';
                    btn.textContent = '@Model.ShowAlarmsLabel';
                }
            }
        }
    </script>
}