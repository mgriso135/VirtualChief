@{
    ViewBag.Title = "Aggiungi Commessa";
    Layout = "~/Site.cshtml";
}

<div class="panel panel-default">
    <div class="panel-heading">
        <h3 class="panel-title">Aggiungi Commessa</h3>
    </div>
    <div class="panel-body">
        <form class="form-horizontal">
            <div class="form-group">
                <label class="control-label col-sm-2" for="cliente">Cliente:</label>
                <div class="col-sm-10">
                    <input type="text" class="form-control" id="cliente" placeholder="Nome cliente" />
                </div>
            </div>
            <div class="form-group">
                <label class="control-label col-sm-2" for="ragioneSociale">Ragione Sociale:</label>
                <div class="col-sm-10">
                    <input type="text" class="form-control" id="ragioneSociale" placeholder="Ragione sociale" />
                </div>
            </div>
            <div class="form-group">
                <label class="control-label col-sm-2" for="esterno">External ID:</label>
                <div class="col-sm-10">
                    <input type="text" class="form-control" id="esterno" placeholder="External ID" />
                </div>
            </div>
            <div class="form-group">
                <label class="control-label col-sm-2" for="note">Note:</label>
                <div class="col-sm-10">
                    <textarea class="form-control" rows="3" id="note"></textarea>
                </div>
            </div>
            <div class="form-group">
                <div class="col-sm-offset-2 col-sm-10">
                    <button type="submit" class="btn btn-primary">Salva</button>
                    <button type="button" class="btn btn-warning">Annulla</button>
                </div>
            </div>
        </form>
    </div>
</div>
