@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService Authorization
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Virtual Chief</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-3">
        <div class="container-fluid">
            <a class="navbar-brand" asp-page="/Index">Virtual Chief</a>
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link" asp-page="/Clienti/Clienti">Clienti</a></li>
                <li class="nav-item"><a class="nav-link" asp-page="/Commesse/commesse">Commesse</a></li>
                <li class="nav-item"><a class="nav-link" asp-page="/Produzione/produzione">Produzione</a></li>
                <li class="nav-item"><a class="nav-link" asp-page="/Reparti/listReparti">Reparti</a></li>
                <li class="nav-item"><a class="nav-link" asp-page="/Users/listUsers">Utenti</a></li>
                <li class="nav-item"><a class="nav-link" asp-page="/Analysis/analysis">Analysis</a></li>
            </ul>
            <ul class="navbar-nav">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    var ws = CurrentWorkspace.Of(User);
                    <li class="nav-item">
                        <span class="navbar-text text-info me-3">
                            @User.Identity.Name @(string.IsNullOrEmpty(ws) ? "" : $"@ {ws}")
                        </span>
                    </li>
                    <li class="nav-item"><a class="nav-link" asp-page="/Login/selectWorkspace">Cambia workspace</a></li>
                    <li class="nav-item">
                        <form method="post" asp-page="/Login/login" asp-page-handler="Logout" class="d-inline">
                            <button type="submit" class="btn btn-outline-light btn-sm">Esci</button>
                        </form>
                    </li>
                }
                else
                {
                    <li class="nav-item"><a class="nav-link" asp-page="/Login/login">Accedi</a></li>
                }
            </ul>
        </div>
    </nav>
    <main class="container">
        @RenderBody()
    </main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
