@inherits KIS.Andon.AndonCompletoViewFields
@{
    // placeholder – markup reproduced from AndonCompletoViewFields.ascx
}
<div class="row-fluid">
    <div class="span12">
        <label id="lbl1" />
        <label id="lblInfo" class="text-info" />
        <table>
            <thead>
                <tr><th colspan="3"><label id="lblTHProdotto" /></th></tr>
            </thead>
            <tbody>
                <!-- Fields (Prodotto) generated by code‑behind / AJAX -->
                <tr>
                    <td><input type="hidden" id="idVFieldName" value="key" /><button class="btn btn-link btn-xs"><i class="icon-arrow-up"></i></button></td>
                    <td><button class="btn btn-link btn-xs"><i class="icon-arrow-down"></i></button></td>
                    <td>Campo Example</td>
                    <td><button class="btn btn-link btn-xs"><i class="icon-delete"></i></button></td>
                </tr>
                <!-- Add new field -->
                <tr>
                    <td><input type="hidden" id="idPFieldName" value="key" /><button class="btn btn-link btn-xs"><i class="icon-add"></i></button></td>
                    <td></td>
                    <td>Nuovo campo</td>
                    <td></td>
                </tr>
            </tbody>
        </table>

        <!-- Sezione Tasks -->
        <table>
            <thead>
                <tr><th colspan="3"><label id="lblTHTasks" /></th></tr>
            </thead>
            <tbody>
                <!-- Fields (Tasks) generated by code‑behind / AJAX -->
                <tr>
                    <td><input type="hidden" id="idVFieldTaskName" value="key" /><button class="btn btn-link btn-xs"><i class="icon-arrow-up"></i></button></td>
                    <td><button class="btn btn-link btn-xs"><i class="icon-arrow-down"></i></button></td>
                    <td>Task campo</td>
                    <td><button class="btn btn-link btn-xs"><i class="icon-delete"></i></button></td>
                </tr>
                <!-- Add new task field -->
                <tr>
                    <td><input type="hidden" id="idPFieldTaskName" value="key" /><button class="btn btn-link btn-xs"><i class="icon-add"></i></button></td>
                    <td></td>
                    <td>Nuovo task</td>
                    <td></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<script type="text/javascript">
    $(function () {
        // Original used Sys.WebForms.PageRequestManager + UpdatePanel; simplified here.
        $("#lblInfo").delay(3000).fadeOut("slow", function () {
            $(this).text('');
        });
    });
</script>