<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!--
      Points the legacy business classes (which build tenant connection strings via
      Dati.GetConnectionString by replacing "database=") at the private MariaDB
      provisioned by tests/provision-db.sh. Override via VC_DB_* by editing here.
    -->
    <add name="masterDB" connectionString="server=127.0.0.1;port=3307;user id=vc;password=vc;database=;pooling=true" />
    <add name="vcmain" connectionString="server=127.0.0.1;port=3307;user id=vc;password=vc;database=vcmain;pooling=true" />
  </connectionStrings>
</configuration>
