@{
    ViewBag.Title = "Customer Pareto";
    Layout = "~/Site.cshtml";
}

<div class="panel panel-default">
    <div class="panel-heading">
        <h3 class="panel-title">Customer Pareto</h3>
    </div>
    <div class="panel-body">
        <p>Analisi Pareto clienti in conversione.</p>
        <p>Il grafico asp:Chart è stato sostituito con Google Charts placeholder.</p>
        <div id="paretoChart" style="width: 600px; height: 400px;"></div>
        <script type="text/javascript">
            google.charts.load('current', {'packages':['corechart']});
            google.charts.setOnLoadCallback(drawChart);
            function drawChart() {
                var data = new google.visualization.DataTable();
                data.addColumn('string', 'Cliente');
                data.addColumn('number', 'Importo');
                // data.addRow(['Cliente A', 1000]);
                
                var options = {
                    title: 'Pareto Clienti',
                    hAxis: {title: 'Cliente'},
                    vAxis: {title: 'Importo'},
                    seriesType: 'bars',
                    series: {0: {type: 'bar'}}
                };
                
                var chart = new google.visualization.ColumnChart(document.getElementById('paretoChart'));
                chart.draw(data, options);
            }
        </script>
    </div>
</div>
