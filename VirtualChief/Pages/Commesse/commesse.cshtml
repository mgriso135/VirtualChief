@page
@model VirtualChief.Pages.Commesse.CommesseModel
@{
    ViewData["Title"] = "Commesse";
}

<div class="container">
    <h1>Gestione Commesse</h1>

    <div class="row">
        <div class="col-md-12">
            <h4>Lista Commesse</h4>
            <hr />
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Commessa</th>
                            <th>Cliente</th>
                            <th>Data Inserimento</th>
                            <th>Note</th>
                            <th>Confermata</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var commessa in Model.Commesse)
                        {
                            <tr>
                                <td>@commessa.ID/@commessa.Year</td>
                                <td>@commessa.RagioneSocialeCliente</td>
                                <td>@commessa.DataInserimento.ToShortDateString()</td>
                                <td>@commessa.Note</td>
                                <td>@(commessa.Confirmed ? "Sì" : "No")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
