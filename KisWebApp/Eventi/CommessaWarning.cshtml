@inherits KIS.Eventi.CommessaWarning
@{
    // placeholder – markup reproduced from CommessaWarning.ascx
}
<h3><img src="~/img/iconEmail.png" height="50" id="imgTitle" />
    <label id="lblTitleCfgWarn" /></h3>
<label id="lbl1" />

<table class="table table-striped table-condensed table-hover">
    <tbody>
        <tr>
            <td>
                <h5><label id="lblCfgWarnGroup" /></h5>
                <button type="button" id="btnShowAddWarningGruppo" class="btn-link">+</button>
                <label id="lblCfgWarnGroupAdd" />
                <table id="frmAddWarningGruppo" style="display:none;" class="table table-condensed">
                    <tr>
                        <td><label id="lblCfgWarnGroupSel" />:</td>
                        <td><select id="ddlAddWarningGruppo"><option value="">--</option></select></td>
                        <td>
                            <button type="button" id="btnSaveWarningGruppo" class="btn btn-success">Salva</button>
                            <button type="button" id="btnUndoWarningGruppo" class="btn">Annulla</button>
                        </td>
                    </tr>
                </table>
                <table class="table table-striped table-condensed table-hover">
                    <tbody>
                        <!-- Items generated by code‑behind / AJAX -->
                    </tbody>
                </table>
            </td>
            <td>
                <h5><label id="lblCfgWarnUser" /></h5>
                <button type="button" id="btnShowAddWarningUtente" class="btn-link">+</button>
                <label id="lblCfgWarnUserAdd" />
                <table id="frmAddWarningUtente" style="display:none;">
                    <tr>
                        <td><label id="lblCfgWarnUserSel" />:</td>
                        <td><select id="ddlAddWarningUtente"><option value="">--</option></select></td>
                        <td>
                            <button type="button" id="btnSaveWarningUtente" class="btn btn-success">Salva</button>
                            <button type="button" id="btnUndoWarningUtente" class="btn">Annulla</button>
                        </td>
                    </tr>
                </table>
                <table class="table table-striped table-condensed table-hover">
                    <tbody>
                        <!-- Items generated by code‑behind / AJAX -->
                    </tbody>
                </table>
            </td>
        </tr>
    </tbody>
</table>

<script type="text/javascript">
    $(function () {
        $("#btnShowAddWarningGruppo").click(function () { $("#frmAddWarningGruppo").toggle(); });
        $("#btnShowAddWarningUtente").click(function () { $("#frmAddWarningUtente").toggle(); });
        $("#btnSaveWarningGruppo").click(function () { alert("Gruppo aggiunto"); });
        $("#btnSaveWarningUtente").click(function () { alert("Utente aggiunto"); });
    });
</script>