@inherits KIS.Produzione.wlReparto
@{
    // placeholder – markup reproduced from wlReparto.ascx
}
<div class="row-fluid">
    <table class="table table-condensed">
        <tr>
            <td>
                <div class="accordion" id="accordion1">
                    <div class="accordion-group">
                        <div class="accordion-heading">
                            <a class="accordion-toggle" data-toggle="collapse" data-parent="#accordion1" href="#collapseOne">
                                <span><%$Resources:lblAccCalendario %></span>
                            </a>
                        </div>
                        <div id="collapseOne" class="accordion-body collapse in">
                            <div class="accordion-inner">
                                <input type="text" id="calDate" class="datepicker" />
                            </div>
                        </div>
                    </div>
                    <div class="accordion-group">
                        <div class="accordion-heading">
                            <a class="accordion-toggle" data-toggle="collapse" data-parent="#accordion1" href="#collapseTwo">
                                <span><%$Resources:lblAccPostazioni %></span>
                            </a>
                        </div>
                        <div id="collapseTwo" class="accordion-body collapse">
                            <div class="accordion-inner">
                                <select id="rbPostazioni" class="radio">
                                    <option selected="true">Vis Global</option>
                                    <option>Vis Postazione</option>
                                </select>
                                <ul id="chkLstPostazioni">
                                    <!-- Checkboxes generated by code-behind -->
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </td>
            <td>
                <div class="ui-widget">
                    <div class="ui-state-highlight ui-corner-all" style="margin-top: 20px; padding: 0 .7em;">
                        <p><span class="ui-icon ui-icon-info" style="float: left; margin-right: .3em;"></span>
                            <span id="lbl1" /></p>
                    </div>
                </div>
                <br />
                <div id="ChartPlaceholder" style="width:800px;"></div>
            </td>
        </tr>
    </table>
</div>

<script type="text/javascript">
    $(function () {
        $("[id*=calDate]").datepicker({ dateFormat: 'dd/mm/yy' });
    });
    // TODO: replace ChartPlaceholder with Google Chart / D3 implementation
</script>