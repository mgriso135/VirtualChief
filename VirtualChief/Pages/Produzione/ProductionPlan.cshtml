@page "/Produzione/ProductionPlan"
@model VirtualChief.Pages.Produzione.ProductionPlanModel
@{
    ViewData["Title"] = "Piano di Produzione";
}

<div class="container">
    <nav aria-label="breadcrumb" class="mt-3 mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="/Produzione/produzione">@Model.NavProduzione</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">@Model.NavProductionPlan</li>
        </ol>
    </nav>

    <h1>@Model.NavProductionPlan</h1>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>@Model.RepartoName</h3>
        <button class="btn btn-link" onclick="toggleAddForm()">
            <img src="/img/@(Model.ShowAddForm ? "iconCancel.jpg" : "iconAdd.jpg")" height="40" />
        </button>
    </div>

    @if (Model.ShowAddForm)
    {
        <div class="card mb-3">
            <div class="card-header">@Model.AddNewItemLabel</div>
            <div class="card-body">
                <div class="alert alert-info">@Model.AddFormNotImplementedMessage</div>
            </div>
        </div>
    }

    <div class="card">
        <div class="card-body">
            <component type="typeof(Components.Produzione.ShowProductionPlan)" 
                       param-Tenant="@Model.Tenant"
                       param-HasPermission="@Model.HasPermission"
                       param-RepId="@Model.RepId"
                       render-mode="ServerPrerendered" />
             
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger mt-3">@Model.ErrorMessage</div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleAddForm() {
            // This would need to call the server to toggle the form
            // For now, just reload the page with a query parameter
            window.location.href = window.location.pathname + '?toggleForm=true';
        }
    </script>
}