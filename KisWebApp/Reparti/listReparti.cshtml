@model IEnumerable<KIS.Reparti.Reparto>

<div class="panel panel-default">
    <div class="panel-heading">
        <h3 class="panel-title">Lista Reparti</h3>
    </div>
    <div class="panel-body">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID Reparto</th>
                    <th>Nome Reparto</th>
                    <th>Descrizione</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ID</td>
                        <td>@item.Nome</td>
                        <td>@item.Descrizione</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
