@inherits KIS.Postazioni.viewPostazione
@{
    // placeholder – markup reproduced from viewPostazione.aspx
}
<ul class="breadcrumb hidden-phone">
    <li>
        <a href="managePostazioniLavoro.cshtml">
            <label id="lblNavGestPostazioni" />
        </a>
        <span class="divider">/</span>
        <a href="@Request.RawUrl"><label id="lblNavCfgPostazione" /></a>
        <span class="divider">/</span>
    </li>
</ul>
<h3><label id="lblNomePost" /></h3>
<label id="lblDescPost" />
<br />
<label id="lbl1" />

<div class="accordion" id="accordion1">
    <div class="accordion-group">
        <div class="accordion-heading">
            <a class="accordion-toggle" data-toggle="collapse" data-parent="#accordion1" href="#collapseFour">
                <label id="lblEditPostazione" />
            </a>
        </div>
        <div id="collapseFour" class="accordion-body collapse">
            <div class="accordion-inner">
                @Html.Partial("~/Postazioni/editPostazione.cshtml")
            </div>
        </div>
    </div>

    <div class="accordion-group">
        <div class="accordion-heading">
            <a class="accordion-toggle" data-toggle="collapse" data-parent="#accordion1" href="#collapseOne">
                <label id="lblCalPostazione" />
            </a>
        </div>
        <div id="collapseOne" class="accordion-body collapse">
            <div class="accordion-inner">
                @Html.Partial("~/Postazioni/viewCalendarioPostazione.cshtml")
            </div>
        </div>
    </div>
    <div class="accordion-group">
        <div class="accordion-heading">
            <a class="accordion-toggle" data-toggle="collapse" data-parent="#accordion1" href="#collapseThree">
                <label id="lblRisorseTurno" />
            </a>
        </div>
        <div id="collapseThree" class="accordion-body collapse">
            <div class="accordion-inner">
                @Html.Partial("~/Postazioni/risorsePostazione.cshtml")
            </div>
        </div>
    </div>
</div>