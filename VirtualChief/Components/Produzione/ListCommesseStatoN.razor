@using KIS.App_Code
@using KIS.App_Sources
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using System.Net.Http
@using System.Net.Http.Json
@inject ILogger<ListCommesseStatoN> Logger
@inject NavigationManager NavigationManager
@inject HttpClient HttpClient

<h3>@Title</h3>

@if (!string.IsNullOrEmpty(SuccessMessage))
{
    <div class="alert alert-success">@SuccessMessage</div>
}

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger">@ErrorMessage</div>
}

@if (!HasPermission)
{
    <div class="alert alert-warning">@PermissionDeniedMessage</div>
}
else if (Articoli == null || Articoli.Count == 0)
{
    <div class="alert alert-info">@NothingToPlanMessage</div>
}
else
{
    <table class="table table-striped table-hover table-condensed">
        <thead>
            <tr>
                <th></th>
                <th>@IdLabel</th>
                <th>@CustomerLabel</th>
                <th>@SerialNumberLabel</th>
                <th>@ProductTypeLabel</th>
                <th>@QuantityLabel</th>
                <th>@ProductionEndDateLabel</th>
                <th>@DeliveryDateLabel</th>
                <th>@LaunchInProductionLabel</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var articolo in Articoli)
            {
                <tr>
                    <td>
                        <button class="btn btn-link p-0" @onclick="@(() => ToggleAssignSerialNumber(articolo))" title="@AssignSerialNumberTooltip">
                            <img src="~/img/iconSerialNumber1.jpg" height="40" />
                        </button>
                    </td>
                    <td>@articolo.ID/@articolo.Year</td>
                    <td>@articolo.Cliente</td>
                    <td>
                        @if (ShowSerialNumberInput.ContainsKey(articolo.IDCombinato) && ShowSerialNumberInput[articolo.IDCombinato])
                        {
                            <input type="text" class="form-control" @bind="SerialNumberInputs[articolo.IDCombinato]" />
                            <button class="btn btn-sm btn-success mt-1" @onclick="@(() => SaveSerialNumber(articolo))" title="@SaveSerialNumberTooltip">
                                <img src="~/img/iconSave.jpg" height="20" />
                            </button>
                            <button class="btn btn-sm btn-secondary mt-1" @onclick="@(() => CancelSerialNumber(articolo))" title="@ResetSerialNumberTooltip">
                                <img src="~/img/iconUndo.png" height="20" />
                            </button>
                        }
                        else
                        {
                            <span>@articolo.Matricola</span>
                            <button class="btn btn-link p-0 ms-2" @onclick="@(() => ToggleAssignSerialNumber(articolo))" title="@AssignSerialNumberTooltip">
                                <img src="~/img/iconSerialNumber1.jpg" height="20" />
                            </button>
                        }
                    </td>
                    <td>@articolo.Proc?.process?.processName &nbsp;-&nbsp; @articolo.Proc?.variant?.nomeVariante</td>
                    <td>@articolo.Quantita</td>
                    <td>
                        <button class="btn btn-link p-0" @onclick="@(() => ToggleChangeProductionEndDate(articolo))" title="@ChangeProductionEndDateTooltip">
                            <img src="~/img/iconCalendar.png" height="40" />
                        </button>
                        @articolo.DataPrevistaFineProduzione.ToString("dd/MM/yyyy HH:mm:ss")

                        @if (ShowDatePicker.ContainsKey(articolo.IDCombinato) && ShowDatePicker[articolo.IDCombinato])
                        {
                            <div class="mt-2">
                                <input type="date" class="form-control d-inline-block w-auto" @bind="SelectedDates[articolo.IDCombinato]" />
                                <label>HH:</label>
                                <select class="form-control d-inline-block w-auto" @bind="SelectedHours[articolo.IDCombinato]">
                                    @for (int i = 0; i < 24; i++)
                                    {
                                        <option value="@i">@i.ToString("D2")</option>
                                    }
                                </select>
                                <label>mm:</label>
                                <select class="form-control d-inline-block w-auto" @bind="SelectedMinutes[articolo.IDCombinato]">
                                    @for (int i = 0; i < 60; i++)
                                    {
                                        <option value="@i">@i.ToString("D2")</option>
                                    }
                                </select>
                                <label>ss:</label>
                                <select class="form-control d-inline-block w-auto" @bind="SelectedSeconds[articolo.IDCombinato]">
                                    @for (int i = 0; i < 60; i++)
                                    {
                                        <option value="@i">@i.ToString("D2")</option>
                                    }
                                </select>
                                <button class="btn btn-sm btn-success ms-2" @onclick="@(() => SaveProductionEndDate(articolo))" title="@SaveTooltip">
                                    <img src="~/img/iconSave.jpg" height="20" />
                                </button>
                                <button class="btn btn-sm btn-secondary" @onclick="@(() => CancelProductionEndDate(articolo))" title="@UndoTooltip">
                                    <img src="~/img/iconUndo.png" height="20" />
                                </button>
                            </div>
                        }
                    </td>
                    <td>@articolo.DataPrevistaConsegna.ToString("dd/MM/yyyy")</td>
                    <td>
                        <div class="d-flex gap-1">
                            @if (articolo.Proc != null && articolo.Proc.process != null)
                            {
                                <button class="btn btn-primary btn-sm" @onclick="@(() => LaunchInProduction(articolo))" 
                                        title="@LaunchInProductionTooltip" disabled="@IsLaunching.GetValueOrDefault(articolo.IDCombinato, false)">
                                    @if (IsLaunching.GetValueOrDefault(articolo.IDCombinato, false))
                                    {
                                        <span class="spinner-border spinner-border-sm" role="status"></span>
                                    }
                                    else
                                    {
                                        <img src="~/img/iconProductionLaunch.png" height="20" />
                                    }
                                </button>
                            }
                            <a href="@($"/configuraProcesso.aspx?ID={articolo.ID}&Year={articolo.Year}")" class="btn btn-link p-0" title="@ConfigureProcessTooltip">
                                <img src="~/img/iconProductionPlan.png" height="40" />
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Parameter]
    public string Tenant { get; set; }

    [Parameter]
    public bool HasPermission { get; set; } = false;

    [Parameter]
    public List<Articolo> Articoli { get; set; } = new();

    public string Title { get; set; } = "Righe d'ordine non programmate in produzione";
    public string IdLabel { get; set; } = "ID";
    public string CustomerLabel { get; set; } = "Cliente";
    public string SerialNumberLabel { get; set; } = "Matricola";
    public string ProductTypeLabel { get; set; } = "Tipo prodotto";
    public string QuantityLabel { get; set; } = "Quantità";
    public string ProductionEndDateLabel { get; set; } = "Data prevista fine produzione";
    public string DeliveryDateLabel { get; set; } = "Data consegna prevista";
    public string LaunchInProductionLabel { get; set; } = "Lancia in produzione";
    public string LaunchInProductionTooltip { get; set; } = "Lancia in produzione";
    public string ConfigureProcessTooltip { get; set; } = "Configura processo";
    public string AssignSerialNumberTooltip { get; set; } = "Assegna una matricola";
    public string SaveSerialNumberTooltip { get; set; } = "Salva la matricola";
    public string ResetSerialNumberTooltip { get; set; } = "Reset matricola";
    public string ChangeProductionEndDateTooltip { get; set; } = "Cambia data fine produzione";
    public string SaveTooltip { get; set; } = "Salva";
    public string UndoTooltip { get; set; } = "Annulla";
    public string NothingToPlanMessage { get; set; } = "Complimenti, tutte le righe d'ordine sono state programmate in produzione.";
    public string PermissionDeniedMessage { get; set; } = "Non hai il permesso di visualizzare i prodotti da inserire in produzione";
    public string ErrorDateMessage { get; set; } = "Errore: data fine produzione antecedente ad oggi oppure eccedente la data di prevista consegna.";
    public string ErrorGenericMessage { get; set; } = "Errore generico.";

    public Dictionary<string, bool> ShowSerialNumberInput { get; set; } = new();
    public Dictionary<string, string> SerialNumberInputs { get; set; } = new();
    public Dictionary<string, bool> ShowDatePicker { get; set; } = new();
    public Dictionary<string, DateTime> SelectedDates { get; set; } = new();
    public Dictionary<string, int> SelectedHours { get; set; } = new();
    public Dictionary<string, int> SelectedMinutes { get; set; } = new();
    public Dictionary<string, int> SelectedSeconds { get; set; } = new();
    public Dictionary<string, bool> IsLaunching { get; set; } = new();
    public string ErrorMessage { get; set; } = "";
    public string SuccessMessage { get; set; } = "";

    protected override void OnInitialized()
    {
        LoadResources();
        InitializeState();
    }

    protected override void OnParametersSet()
    {
        InitializeState();
    }

    private void LoadResources()
    {
        Title = "Righe d'ordine non programmate in produzione";
        IdLabel = "ID";
        CustomerLabel = "Cliente";
        SerialNumberLabel = "Matricola";
        ProductTypeLabel = "Tipo prodotto";
        QuantityLabel = "Quantità";
        ProductionEndDateLabel = "Data prevista fine produzione";
        DeliveryDateLabel = "Data consegna prevista";
        LaunchInProductionLabel = "Lancia in produzione";
        LaunchInProductionTooltip = "Lancia in produzione";
        ConfigureProcessTooltip = "Configura processo";
        AssignSerialNumberTooltip = "Assegna una matricola";
        SaveSerialNumberTooltip = "Salva la matricola";
        ResetSerialNumberTooltip = "Reset matricola";
        ChangeProductionEndDateTooltip = "Cambia data fine produzione";
        SaveTooltip = "Salva";
        UndoTooltip = "Annulla";
        NothingToPlanMessage = "Complimenti, tutte le righe d'ordine sono state programmate in produzione.";
        PermissionDeniedMessage = "Non hai il permesso di visualizzare i prodotti da inserire in produzione";
        ErrorDateMessage = "Errore: data fine produzione antecedente ad oggi oppure eccedente la data di prevista consegna.";
        ErrorGenericMessage = "Errore generico.";
    }

    private void InitializeState()
    {
        foreach (var art in Articoli)
        {
            if (!ShowSerialNumberInput.ContainsKey(art.IDCombinato))
            {
                ShowSerialNumberInput[art.IDCombinato] = false;
                SerialNumberInputs[art.IDCombinato] = art.Matricola ?? "";
                ShowDatePicker[art.IDCombinato] = false;
                SelectedDates[art.IDCombinato] = DateTime.Today;
                SelectedHours[art.IDCombinato] = DateTime.Now.Hour;
                SelectedMinutes[art.IDCombinato] = DateTime.Now.Minute;
                SelectedSeconds[art.IDCombinato] = DateTime.Now.Second;
                IsLaunching[art.IDCombinato] = false;
            }
        }
    }

    private void ToggleAssignSerialNumber(Articolo art)
    {
        ShowSerialNumberInput[art.IDCombinato] = !ShowSerialNumberInput.GetValueOrDefault(art.IDCombinato, false);
        if (ShowSerialNumberInput[art.IDCombinato])
        {
            SerialNumberInputs[art.IDCombinato] = art.Matricola ?? "";
        }
    }

    private void SaveSerialNumber(Articolo art)
    {
        try
        {
            art.Matricola = SerialNumberInputs.GetValueOrDefault(art.IDCombinato, "");
            ErrorMessage = art.log;
            ShowSerialNumberInput[art.IDCombinato] = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving serial number");
            ErrorMessage = ErrorGenericMessage;
        }
    }

    private void CancelSerialNumber(Articolo art)
    {
        SerialNumberInputs[art.IDCombinato] = art.Matricola ?? "";
        ShowSerialNumberInput[art.IDCombinato] = false;
    }

    private void ToggleChangeProductionEndDate(Articolo art)
    {
        ShowDatePicker[art.IDCombinato] = !ShowDatePicker.GetValueOrDefault(art.IDCombinato, false);
        if (ShowDatePicker[art.IDCombinato])
        {
            SelectedDates[art.IDCombinato] = art.DataPrevistaFineProduzione.Date;
            SelectedHours[art.IDCombinato] = art.DataPrevistaFineProduzione.Hour;
            SelectedMinutes[art.IDCombinato] = art.DataPrevistaFineProduzione.Minute;
            SelectedSeconds[art.IDCombinato] = art.DataPrevistaFineProduzione.Second;
        }
    }

    private void SaveProductionEndDate(Articolo art)
    {
        try
        {
            var fineProd = new DateTime(
                SelectedDates[art.IDCombinato].Year,
                SelectedDates[art.IDCombinato].Month,
                SelectedDates[art.IDCombinato].Day,
                SelectedHours[art.IDCombinato],
                SelectedMinutes[art.IDCombinato],
                SelectedSeconds[art.IDCombinato]);

            if (fineProd > DateTime.Now && fineProd <= art.DataPrevistaConsegna)
            {
                art.DataPrevistaFineProduzione = fineProd;
                ErrorMessage = art.log;
                NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
            }
            else
            {
                ErrorMessage = ErrorDateMessage;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving production end date");
            ErrorMessage = ErrorGenericMessage;
        }
        finally
        {
            ShowDatePicker[art.IDCombinato] = false;
        }
    }

    private void CancelProductionEndDate(Articolo art)
    {
        ShowDatePicker[art.IDCombinato] = false;
    }

    private async Task LaunchInProduction(Articolo art)
    {
        try
        {
            IsLaunching[art.IDCombinato] = true;
            ErrorMessage = "";
            SuccessMessage = "";

            var response = await HttpClient.PostAsync($"api/produzione/lancia/{art.ID}/{art.Year}", null);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<LaunchResult>();
                SuccessMessage = result?.Message ?? "Articolo lanciato in produzione con successo";
                NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorResponse>();
                ErrorMessage = error?.Error ?? "Errore durante il lancio in produzione";
                if (error?.Details != null)
                {
                    ErrorMessage += ": " + error.Details;
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error launching in production");
            ErrorMessage = ErrorGenericMessage;
        }
        finally
        {
            IsLaunching[art.IDCombinato] = false;
        }
    }

    private class LaunchResult
    {
        public bool Success { get; set; }
        public string Message { get; set; }
        public string Log { get; set; }
    }

    private class ErrorResponse
    {
        public string Error { get; set; }
        public string Details { get; set; }
        public int Code { get; set; }
    }
}