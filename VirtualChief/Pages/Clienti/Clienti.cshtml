@page
@model VirtualChief.Pages.Clienti.ClientiModel
@{
    ViewData["Title"] = "Clienti";
}

<div class="container">
    <h1>Gestione Clienti</h1>

    <div class="row">
        <div class="col-md-12">
            <h4>Elenco Clienti</h4>
            <hr />
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Codice</th>
                        <th>Ragione Sociale</th>
                        <th>Partita IVA</th>
                        <th>Codice Fiscale</th>
                        <th>Citt&agrave;</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var client in Model.Clients)
                    {
                        <tr>
                            <td>@client.CodiceCliente</td>
                            <td>@client.RagioneSociale</td>
                            <td>@client.PartitaIVA</td>
                            <td>@client.CodiceFiscale</td>
                            <td>@client.Citta</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
