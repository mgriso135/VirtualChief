@page
@model VirtualChief.Pages.Commesse.NuovoOrdineModel
@{
    ViewData["Title"] = "Nuovo Ordine - Passo 1";
}

<div class="container">
    <div class="row mb-4">
        <div class="col-md-12">
            <nav aria-label="Wizard steps">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item active"><strong>1. Dati Commesa</strong></li>
                    <li class="breadcrumb-item"><span class="text-muted">2. Prodotti</span></li>
                    <li class="breadcrumb-item"><span class="text-muted">3. Reparto</span></li>
                    <li class="breadcrumb-item"><span class="text-muted">4. Conferma</span></li>
                </ol>
            </nav>
            <h1>Nuovo Ordine - Dati Commesa</h1>
            <hr />
        </div>
    </div>

    <form method="post">
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }
        
        <div class="row">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h5>Informazioni Commesa</h5>
                    </div>
                    <div class="card-body">
                        <div class="form-group">
                            <label for="SelectedCliente">Cliente <span class="text-danger">*</span></label>
                            <select class="form-control" id="SelectedCliente" name="SelectedCliente" required>
                                <option value="">Seleziona un cliente...</option>
                                @foreach (var cliente in Model.Clienti)
                                {
                                    if (Model.SelectedCliente == cliente.CodiceCliente)
                                    {
                                        <option value="@cliente.CodiceCliente" selected>
                                            @cliente.RagioneSociale (@cliente.CodiceCliente)
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@cliente.CodiceCliente">
                                            @cliente.RagioneSociale (@cliente.CodiceCliente)
                                        </option>
                                    }
                                }
                            </select>
                        </div>
                        
                        <div class="form-group">
                            <label for="ExternalID">External ID</label>
                            <input type="text" class="form-control" id="ExternalID" name="ExternalID" value="@Model.ExternalID" placeholder="ID esterno (es. ordine ERP)" />
                        </div>
                        
                        <div class="form-group">
                            <label for="Note">Note</label>
                            <textarea class="form-control" id="Note" name="Note" rows="3" placeholder="Note per la commessa">@Model.Note</textarea>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h5>Informazioni</h5>
                    </div>
                    <div class="card-body">
                        <p>Inserisci i dati della nuova commessa. Il cliente è obbligatorio.</p>
                        <p>Dopo aver creato la commessa, potrai aggiungere i prodotti (articoli) e associare i reparti di produzione.</p>
                        <hr />
                        <h6>Flusso guidato:</h6>
                        <ol>
                            <li class="text-primary"><strong>Dati Commesa</strong> - Inserisci cliente, note, external ID</li>
                            <li>Prodotti - Aggiungi prodotti/PERT alla commessa</li>
                            <li>Reparto - Associa il reparto di produzione</li>
                            <li>Conferma - Riepilogo e conferma finale</li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="row mt-3">
            <div class="col-md-12">
                <button type="submit" class="btn btn-primary btn-lg">Crea Commesa e Continua <i class="fas fa-arrow-right"></i></button>
                <a href="/Commesse/commesse" class="btn btn-secondary btn-lg">Annulla</a>
            </div>
        </div>
    </form>
</div>