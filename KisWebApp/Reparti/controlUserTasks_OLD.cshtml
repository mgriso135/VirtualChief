@inherits KIS.Produzione.controlUserTasks
@{
    // placeholder – markup reproduced from controlUserTasks_OLD.ascx
}
<div class="row-fluid">
    <div class="span12">
        <label id="lbl1" /><br />
        <h3>Linea Produzione</h3>
        <table>
            <tr style="font-size:20px; font-weight:bold">
                <td>Linea</td>
                <td><label id="lblMatricola" /></td>
                <td><label id="lblTaskID" /></td>
                <td><label id="lblTaskName" /></td>
                <td><label id="lblCadenza" /></td>
                <td><label id="lblAzione" /></td>
            </tr>
            <!-- Items generated by code‑behind or AJAX -->
            <tr style="font-size:16px">
                <td>Esempio Padre</td>
                <td>12345</td>
                <td><input type="hidden" id="taskID" value="1" />T1</td>
                <td>Task Example</td>
                <td>8h</td>
                <td>
                    <button class="btn btn-primary btn-sm">Start</button>
                    <button class="btn btn-link btn-sm">Pause</button>
                    <button class="btn btn-link btn-sm">Complete</button>
                    <button class="btn btn-warning btn-sm">Warning</button>
                </td>
            </tr>
        </table>
    </div>
</div>

<script type="text/javascript">
    $(function () {
        // Original had a Timer that fired every 10s (OnTick="Timer1_Tick");
        // here we just simulate with a setInterval console log.
        setInterval(function () {
            // console.log("Tick"); // remove or keep for debugging
        }, 10000);

        // Original LinkButtons replaced with simple buttons.
        $(".btn-primary").click(function () { alert("Start task"); });
        $(".btn-link").filter(":contains('Pause')").click(function () { alert("Pause task"); });
        $(".btn-link").filter(":contains('Complete')").click(function () { alert("Complete task"); });
        $(".btn-warning").click(function () { alert("Warning"); });
    });
</script>