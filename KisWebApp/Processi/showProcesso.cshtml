@inherits KIS.Processi.showProcesso
@{
    // placeholder – markup reproduced from showProcesso.aspx
}
<script>
    $(document).ready(function () {
        function loadParameters() {
            if ($('#ProcessID').val() != "-1" &&
                $('#ProcessRev').val() != "-1" &&
                $('#VariantID').val() != "-1") {
                var procID = parseInt($('#ProcessID').val());
                var procRev = parseInt($('#ProcessRev').val());
                var varID = parseInt($('#VariantID').val());
                $('#imgLoadParams').show();
                $.ajax({
                    url: "../Products/ProductParameters/Index",
                    type: 'GET',
                    dataType: 'html',
                    data: {
                        processID: $('#ProcessID').val(),
                        processRev: $('#ProcessRev').val(),
                        variantID: $('#VariantID').val()
                    },
                    success: function (result) {
                        $('#divProcessParams').html(result);
                        $('#imgLoadParams').hide();
                    },
                    error: function (result) {
                    }
                });
            }
            else {
                $('#imgLoadParams').hide();
            }
        }

        $('#imgShowAddParams').click(function () {
            if ($('#addParams').is(':visible')) {
                $('#addParams').fadeOut();
            }
            else {
                $('#addParams').fadeIn();
            }
        });

        $('#imgAddParam').click(function () {
            $('#imgAddParam').fadeOut();
            $('#imgLoadAddParam').fadeIn();
            var procID = parseInt($('#ProcessID').val());
            var procRev = parseInt($('#ProcessRev').val());
            var varID = parseInt($('#VariantID').val());
            var paramName = $('<div/>').text($('#txtParamName').val()).html();
            var paramDescription = $('<div/>').text($('#txtParamDescription').val()).html();
            var paramIsFixed = false;
            if ($('#txtIsFixed').is(":checked")) {
                var paramIsFixed = true;
            }
            var paramIsRequired = false;
            if ($('#txtIsRequired').is(":checked")) {
                var paramIsRequired = true;
            }
            var paramCategory = parseInt($('#ddlParamCategory').val());

            if (procID > -1 && procRev > -1 && varID > -1) {
                if (paramName.length > 0) {
                    if (paramCategory > -1) {
                        $.ajax({
                            url: "../Products/ProductParameters/AddParam",
                            type: 'GET',
                            dataType: 'html',
                            data: {
                                processID: procID,
                                processRev: procRev,
                                variantID: varID,
                                ParamName: paramName,
                                ParamDescription: paramDescription,
                                ParamCategory: paramCategory,
                                ParamIsFixed: paramIsFixed,
                                ParamIsRequired: paramIsRequired
                            },
                            success: function (result) {
                                $('#imgAddParam').fadeIn();
                                $('#imgLoadAddParam').fadeOut();
                                $('#addParams').fadeOut();
                                loadParameters();
                                $('#txtParamName').val('');
                                $('#txtParamDescription').val('');
                                $('#txtIsFixed').attr('checked', false);
                                $('#txtIsRequired').attr('checked', false);
                                $("#ddlParamCategory").val('-1');
                            },
                            error: function (result) {
                                $('#imgAddParam').fadeIn();
                                $('#imgLoadAddParam').fadeOut();
                                alert("Errore durante l'aggiunta del parametro");
                            }
                        });
                        loadParameters();
                    }
                    else {
                        alert("Selezionare una categoria");
                        $('#imgAddParam').fadeIn();
                        $('#imgLoadAddParam').fadeOut();
                    }
                }
                else {
                    alert("Inserire un nome per il parametro");
                    $('#imgAddParam').fadeIn();
                    $('#imgLoadAddParam').fadeOut();
                }
            }
        });

        if ($('#ProcessID').val() != "-1" &&
            $('#ProcessRev').val() != "-1" &&
            $('#VariantID').val() != "-1") {
            $('#imgLoadAddParam').hide();
            loadParameters();
        }
        else {
            $('#imgLoadParams').hide();
            $('#lblShowAddParams').hide();
            $('#imgShowAddParams').hide();
            $('#addParams').fadeOut();
            $('#imgLoadAddParam').hide();
        }

        $('#imgLoadAddParam').hide();
    });
</script>

<input type="hidden" id="ProcessID" />
<input type="hidden" id="ProcessRev" />
<input type="hidden" id="VariantID" />

<ul class="breadcrumb hidden-phone">
    <li>
