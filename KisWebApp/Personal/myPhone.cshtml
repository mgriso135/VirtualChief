@inherits KIS.Personal.myPhone
@{
    // placeholder – markup reproduced from myPhone.ascx
}
<button type="button" id="imgShowFormAddPhone" class="btn-link">+</button>
<label id="lblAddPhoneNumber" />
<table id="frmAddPhone" class="table table-bordered table-hover table-condensed">
    <thead>
        <tr>
            <th><label id="lblPhoneNumber" /></th>
            <th><label id="lblAmbito" /></th>
            <th><label id="lblForAlarm" /></th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td><input type="text" id="txtPhone" required /><br />
                <span style="color:red;">* Campo obbligatorio</span>
            </td>
            <td><input type="text" id="txtAmbito" required /><br />
                <span style="color:red;">* Campo obbligatorio</span>
            </td>
            <td><input type="checkbox" id="chkForAlarm" /></td>
            <td>
                <button type="button" id="imgSavePhone" class="btn btn-success">Salva</button>
                <button type="button" id="imgUndoPhone" class="btn">Annulla</button>
            </td>
        </tr>
    </tbody>
</table>
<label id="lbl1" />
<table class="table table-striped table-hover table-condensed">
    <thead>
        <tr>
            <th></th>
            <th><label id="lblPhoneNumber2" /></th>
            <th><label id="lblAmbito2" /></th>
            <th><label id="lblForAlarm2" /></th>
        </tr>
    </thead>
    <tbody>
        <!-- Items generated by code‑behind / AJAX -->
    </tbody>
</table>

<script type="text/javascript">
    $(function () {
        $("#imgSavePhone").click(function () {
            if (!$("#txtPhone").val() || !$("#txtAmbito").val()) {
                alert("Compilare tutti i campi obbligatori");
                return;
            }
            alert("Numero di telefono aggiunto");
        });
    });
</script>