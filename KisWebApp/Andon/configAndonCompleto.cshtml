@inherits KIS.Andon.configAndonCompleto
@{
    // placeholder – markup reproduced from configAndonCompleto.aspx
}
<script>
    $(document).ready(function () {
        function loadScrollTypeView() {
            $("#imgLoadScrollView").fadeIn();
            $.ajax({
                url: "../Config/AndonConfig/ScrollTypeView",
                type: 'GET',
                data: {},
                dataType: 'html',
                success: function (result) {
                    $("#imgLoadScrollView").fadeOut();
                    $('#frmScrollView').html(result);
                },
                error: function (result) { $("#imgLoadScrollView").fadeOut(); alert("Error loadScrollTypeView" + result); }
            });
        }
        loadScrollTypeView();
    });
</script>
<ul class="breadcrumb hidden-phone">
    <li>
        <a href="../Admin/admin.cshtml"><label id="lblNavAdmin" /></a>
        <span class="divider">/</span>
    </li>
    <li>
        <a href="configAndonCompleto.cshtml"><label id="lblNavAndonCfg" /></a>
        <span class="divider">/</span>
    </li>
</ul>
<h3><label id="lblNavAndonCfg2" /></h3>
<label id="lbl1" />

<div class="accordion" id="accordion1">
    <div class="accordion-group">
        <div class="accordion-heading">
            <a class="accordion-toggle" data-toggle="collapse" data-parent="#accordion1" href="#collapseOne">
                <label id="lblAccVisUtenti" />
            </a>
        </div>
        <div id="collapseOne" class="accordion-body collapse">
            <div class="accordion-inner">
                @Html.Partial("~/Andon/configFormatoUsername.cshtml")
            </div>
        </div>
    </div>
    <div class="accordion-group">
        <div class="accordion-heading">
            <a class="accordion-toggle" data-toggle="collapse" data-parent="#accordion1" href="#collapseTwo">
                <label id="lblAccVisCampiAndon" />
            </a>
        </div>
        <div id="collapseTwo" class="accordion-body collapse">
            <div class="accordion-inner">
                @Html.Partial("~/Andon/AndonCompletoViewFields.cshtml")
            </div>
        </div>
    </div>
    <div class="accordion-group">
        <div class="accordion-heading">
            <a class="accordion-toggle" data-toggle="collapse" data-parent="#accordion1" href="#collapseThree">
                <label id="lblAccScrollType" />
            </a>
        </div>
        <div id="collapseThree" class="accordion-body collapse">
            <div class="accordion-inner">
                <img src="../img/iconLoading.gif" id="imgLoadScrollView" style="min-width:20px; max-width:20px;" />
                <div id="frmScrollView"></div>
            </div>
        </div>
    </div>
</div>