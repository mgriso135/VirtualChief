@inherits KIS.Commesse.wzCheckWorkLoadReparto1
@{
    // placeholder – markup reproduced from wzCheckWorkLoadReparto.ascx
}
<script type="text/javascript">
    function FireConfirm() {
        if (confirm('Procedere con il lancio?'))
            return true;
        else
            return false;
    }
</script>

<table class="table table-condensed">
    <tr>
        <td>
            <a href="#"><img src="~/img/iconArrowLeft.png" height="40" /></a>
        </td>
        <td style="vertical-align: top;">
            <div class="accordion" id="accordion1">
                <div class="accordion-group">
                    <div class="accordion-heading">
                        <a class="accordion-toggle" data-toggle="collapse" data-parent="#accordion1" href="#collapseOne">
                            <label id="lblAccDataFineProd" />
                        </a>
                    </div>
                    <div id="collapseOne" class="accordion-body collapse">
                        <div class="accordion-inner">
                            <label id="lblData" />:&nbsp;<input type="text" id="txtProductDate" class="datepicker" style="width:100px;" />
                            <br />
                            <label id="lblOre" />:<select id="calOre" class="dropdown" style="width:70px;"><option>00</option></select>
                            &nbsp;<label id="lblMinuti" />:<select id="calMinuti" class="dropdown" style="width:70px;"><option>00</option></select>
                            &nbsp;<label id="lblSecondi" />:<select id="calSecondi" class="dropdown" style="width:70px;"><option>00</option></select>
                            <br />
                            <button type="button" id="btnSaveDataFineProd" class="btn">Salva</button>
                        </div>
                    </div>
                </div>

                <div class="accordion-group">
                    <div class="accordion-heading">
                        <a class="accordion-toggle" data-toggle="collapse" data-parent="#accordion1" href="#collapseTwo">
                            <label id="lblPostazioni" />
                        </a>
                    </div>
                    <div id="collapseTwo" class="accordion-body collapse">
                        <div class="accordion-inner">
                            <div class="radio">
                                <label><input type="radio" id="rbPostazioni_0" name="rbPostazioni" /> Visualizza tempi complessivi</label>
                                <label><input type="radio" id="rbPostazioni_1" name="rbPostazioni" /> Tempi per postazione</label>
                            </div>
                            <ul id="chkLstPostazioni">
                                <!-- Checkboxes generated by code‑behind -->
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </td>
        <td style="vertical-align: top;">
            <div class="row-fluid">
                <div id="Chart1Placeholder" style="width:1000px; height:400px;"></div>
                <br />
                <div class="ui-widget" id="dvErr">
                    <div class="ui-state-error ui-corner-all" style="padding: 0 .7em;">
                        <p><span class="ui-icon ui-icon-alert" style="float: left; margin-right: .3em;"></span>
                            <strong>Attenzione:</strong>&nbsp;<label id="lblErr" /></p>
                    </div>
                </div>
                <div class="ui-widget" id="dvInfo">
                    <div class="ui-state-highlight ui-corner-all" style="margin-top: 20px; padding: 0 .7em;">
                        <p><span class="ui-icon ui-icon-info" style="float: left; margin-right: .3em;"></span>
                            <label id="lbl1" /></p>
                    </div>
                </div>
            </div>
        </td>
        <td>
            <button type="button" id="imgGoFwd" class="btn" onclick="return FireConfirm();">Avanti</button>
        </td>
    </tr>
</table>

<script type="text/javascript">
    $(function () {
        $("[id*=txtProductDate]").datepicker({ dateFormat: 'dd/mm/yy', showWeek: true, firstDay: 1, minDate: 'today' });
    });
    // TODO: replace Chart1Placeholder with Google Chart / D3 implementation
</script>