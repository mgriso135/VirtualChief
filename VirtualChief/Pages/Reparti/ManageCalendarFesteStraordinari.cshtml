@page "{id:int}"
@model VirtualChief.Pages.Reparti.ManageCalendarFesteStraordinariModel
@{
    ViewData["Title"] = "Calendario di reparto";
}

<div class="container">
    <ul class="breadcrumb" style="background:none; padding-left:0;">
        <li><a asp-page="/Index">Home</a> <span class="divider">/</span></li>
        <li><a asp-page="/Reparti/listReparti">Reparti</a> <span class="divider">/</span></li>
        <li><a asp-page="/Reparti/configReparto" asp-route-id="@Model.Dipartimento?.id">@Model.Dipartimento?.name</a> <span class="divider">/</span></li>
        <li class="active">Calendario turno: @Model.TurnoCorrente?.Nome</li>
    </ul>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }
    else if (Model.CanView && Model.Dipartimento != null && Model.TurnoCorrente != null)
    {
        <h2>Calendario di reparto: @Model.Dipartimento.name - @Model.TurnoCorrente.Nome</h2>

        <div class="row mb-3">
            <div class="col-md-6">
                <a asp-page="/Reparti/ManageFestivita" asp-route-id="@Model.TurnoCorrente.id" target="_blank" class="btn btn-outline-primary">
                    <img src="/img/iconHoliday.png" height="40" /> Gestisci festivit&agrave;
                </a>
            </div>
            <div class="col-md-6 text-md-end">
                <a asp-page="/Reparti/ManageStraordinario" asp-route-id="@Model.TurnoCorrente.id" target="_blank" class="btn btn-outline-primary">
                    <img src="/img/iconOvertime.jpg" height="40" /> Gestisci straordinari
                </a>
            </div>
        </div>

        <form method="get" class="row g-2 align-items-end mb-4">
            <input type="hidden" name="id" value="@Model.TurnoCorrente.id" />
            <div class="col-md-4">
                <label class="form-label small mb-1">Inizio visualizzazione</label>
                <input type="datetime-local" name="start" class="form-control form-control-sm"
                       value="@Model.InizioCalendario.ToString("yyyy-MM-ddTHH:mm")" />
            </div>
            <div class="col-md-4">
                <label class="form-label small mb-1">Fine visualizzazione</label>
                <input type="datetime-local" name="end" class="form-control form-control-sm"
                       value="@Model.FineCalendario.ToString("yyyy-MM-ddTHH:mm")" />
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary btn-sm">Aggiorna</button>
            </div>
        </form>

        <div class="card">
            <div class="card-header">
                <h5>Gantt calendario turno</h5>
            </div>
            <div class="card-body">
                <canvas id="calendarChart" height="300"></canvas>
            </div>
        </div>

        <div class="mt-3 small text-muted">
            <strong>Legenda:</strong>
            <span class="ms-2"><span class="badge" style="background-color:#adff2f;color:#000">Intervalli</span></span>
            <span class="ms-2"><span class="badge" style="background-color:#dc3545">Festivit&agrave;</span></span>
            <span class="ms-2"><span class="badge" style="background-color:#28a745">Straordinari</span></span>
            <span class="ms-2"><span class="badge" style="background-color:@Model.TurnoCorrente.Colore">Turni regolari</span></span>
        </div>
    }
    else
    {
        <div class="alert alert-warning">Seleziona un turno valido.</div>
    }

    <a asp-page="/Reparti/configReparto" asp-route-id="@Model.Dipartimento?.id" class="btn btn-secondary mt-3">&larr; Torna alla configurazione reparto</a>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var ctx = document.getElementById('calendarChart').getContext('2d');
            
            var seriesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Series));
            
            var datasets = seriesData.map(function (s, index) {
                return {
                    label: s.name,
                    data: s.points.map(function (p) {
                        return { x: new Date(p.date).getTime(), y: p.y };
                    }),
                    borderColor: s.color,
                    backgroundColor: s.color,
                    borderWidth: 10,
                    pointRadius: 5,
                    pointHoverRadius: 8,
                    showLine: true,
                    fill: false,
                    spanGaps: false
                };
            });
            
            new Chart(ctx, {
                type: 'line',
                data: { datasets: datasets },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: 'nearest',
                        intersect: false
                    },
                    scales: {
                        x: {
                            type: 'time',
                            time: {
                                unit: 'day',
                                displayFormats: { day: 'dd/MM', hour: 'dd/MM HH:mm' },
                                tooltipFormat: 'dd/MM/yyyy HH:mm:ss'
                            },
                            title: { display: true, text: 'Data' },
                            min: new Date('@Model.InizioCalendario.ToString("yyyy-MM-ddTHH:mm:ss")').getTime(),
                            max: new Date('@Model.FineCalendario.ToString("yyyy-MM-ddTHH:mm:ss")').getTime()
                        },
                        y: {
                            type: 'linear',
                            min: 0.5,
                            max: 4.5,
                            title: { display: true, text: 'Tipo' },
                            ticks: {
                                stepSize: 1,
                                callback: function (value) {
                                    switch (value) {
                                        case 1: return 'Intervalli';
                                        case 2: return 'Festivit\u00e0';
                                        case 3: return 'Straordinari';
                                        case 4: return 'Turni';
                                        default: return '';
                                    }
                                }
                            },
                            grid: { display: false }
                        }
                    },
                    plugins: {
                        tooltip: {
                            callbacks: {
                                title: function (context) {
                                    return context[0].dataset.label;
                                },
                                label: function (context) {
                                    var point = context.dataset.data[context.dataIndex];
                                    return point.tooltip || '';
                                }
                            }
                        },
                        legend: { display: false }
                    }
                }
            });
        });
    </script>
}