@model IEnumerable<KIS.Commesse.Commessa>

<div class="panel panel-default">
    <div class="panel-heading">
        <h3 class="panel-title">Lista Commesse</h3>
    </div>
    <div class="panel-body">
        <table class="table table-striped table-hover table-condensed">
            <thead>
                <tr>
                    <th></th>
                    <th>ID Commessa</th>
                    <th>External ID</th>
                    <th>Data Inserimento</th>
                    <th>Ragione Sociale</th>
                    <th>Note</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <a href="/Commesse/wzAddPERT.aspx?idCommessa=@item.ID&annoCommessa=@item.Year" class="btn btn-xs btn-default">
                                <img src="/img/iconWizard.png" height="40" title="Vai alla wizard" />
                            </a>
                            <a href="/SalesOrders/SalesOrder/AddSalesOrder?OrderID=@item.ID&OrderYear=@item.Year" class="btn btn-xs btn-default">
                                <img src="/img/iconCart1.jpg" height="40" title="Aggiungi prodotti" />
                            </a>
                        </td>
                        <td>@item.ID</td>
                        <td>@item.ExternalID</td>
                        <td>@item.InsertionDate</td>
                        <td>@item.RagSociale</td>
                        <td>@item.Notes</td>
                        <td>@item.Status</td>
                        <td>
                            <!-- Action buttons would go here -->
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
