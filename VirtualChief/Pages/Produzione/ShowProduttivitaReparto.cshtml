@page "/Produzione/ShowProduttivitaReparto"
@model VirtualChief.Pages.Produzione.ShowProduttivitaRepartoModel
@{
    ViewData["Title"] = "Produttività Reparto";
}

<div class="container">
    <nav aria-label="breadcrumb" class="mt-3 mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="/Produzione/produzione">@Model.NavProduzione</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">@Model.NavProduttivitaReparto</li>
        </ol>
    </nav>

    <h1>@Model.NavProduttivitaReparto</h1>

    <div class="card">
        <div class="card-body">
            <component type="typeof(Components.Produzione.ShowProduttivitaReparto)" 
                       param-Tenant="@Model.Tenant"
                       param-HasPermission="@Model.HasPermission"
                       param-RepId="@Model.RepId"
                       render-mode="ServerPrerendered" />
             
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger mt-3">@Model.ErrorMessage</div>
            }
        </div>
    </div>
</div>