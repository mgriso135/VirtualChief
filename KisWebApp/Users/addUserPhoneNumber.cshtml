@inherits KIS.Users.addUserPhoneNumber
@{
    // placeholder – markup reproduced from addUserPhoneNumber.ascx
}
<button type="button" id="imgShowForm" class="btn-link" onclick="toggleForm()"><img src="~/img/iconAdd.jpg" height="40" /></button>
<label id="lblAddPhoneNumber" />

<table id="tblAddPhoneNumber" style="border: 1px dashed blue; display:none;">
    <tr>
        <td><label id="lblPhoneNumber" />
            <br /><input type="tel" id="txtPhoneNumber" required />
            <span style="color:red;"><label id="lblReqField" /></span>
        </td>
        <td><label id="lblAmbito" />
            <br /><input type="text" id="txtNote" required />
            <span style="color:red;"><label id="lblReqField2" /></span>
        </td>
    </tr>
    <tr>
        <td colspan="2">
            <input type="checkbox" id="chkAlarm" />
            <label id="lblUtilizzAllarmi" />
        </td>
    </tr>
    <tr>
        <td colspan="2">
            <button type="button" id="btnSave" class="btn btn-success" onclick="doSave()">Salva</button>
            <button type="button" id="btnUndo" class="btn">Annulla</button>
        </td>
    </tr>
</table>
<label id="lbl1" />

<script type="text/javascript">
    function toggleForm() {
        $("#tblAddPhoneNumber").toggle();
    }
    function doSave() {
        if (!$("#txtPhoneNumber").val() || !$("#txtNote").val()) {
            alert("Compilare tutti i campi obbligatori");
            return;
        }
        alert("Numero aggiunto");
    }
</script>