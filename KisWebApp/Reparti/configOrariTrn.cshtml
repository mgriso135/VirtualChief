@inherits KIS.Reparti.configOrariTrn
@{
    // placeholder – markup reproduced from configOrariTrn.ascx
}
<div class="row-fluid">
    <table class="table table-condensed">
        <tr>
            <td>
                <label id="lbl1" />
                <h3><label id="lblCfgOrari" /></h3>
            </td>
        </tr>
    </table>
</div>

<br />

<div class="row-fluid">
    <table class="table table-condensed" id="frmTurno">
        <tr>
            <td><label id="nomeTurno" />: <input type="text" id="txtNomeTurno" /></td>
            <td rowspan="2">
                <button type="button" id="editNomeTurno" class="btn btn-secondary">Modifica</button>
                <button type="button" id="saveNomeTurno" class="btn btn-success">Salva</button>
                <button type="button" id="undoNomeTurno" class="btn btn-link">Annulla</button>
            </td>
        </tr>
        <tr>
            <td><label id="ddlColore" />: <span id="lblEsempioColore" /></td>
        </tr>
    </table>
</div>

<br />

<div class="row-fluid">
    <table class="table table-condensed" id="frmOrari">
        <thead>
            <tr>
                <th></th>
                <th><label id="lblGiornoInizio" /></th>
                <th><label id="lblOraInizio" /></th>
                <th><label id="lblGiornoFine" /></th>
                <th><label id="lblOraFine" /></th>
                <th><label id="lblDurataTurno" /></th>
            </tr>
        </thead>
        <tbody>
            <!-- Items generated by code‑behind or AJAX -->
            <tr>
                <td><button class="btn btn-danger btn-sm">Cancella</button></td>
                <td>Lunedì</td>
                <td>08:00</td>
                <td>Venerdì</td>
                <td>17:00</td>
                <td>9h</td>
            </tr>
        </tbody>
        <tfoot>
            <tr>
                <td colspan="6" style="text-align:center;">
                    <button type="button" id="imgAddOrario" class="btn">Add Orario</button>
                </td>
            </tr>
        </tfoot>
    </table>
</div>

<br />

<div class="row-fluid">
    <table class="table table-condensed" id="formAddOrario">
        <tr>
            <td><label id="lblInizio" /></td>
            <td>
                <select id="ddlDInizio">
                    <option>Lunedì</option>
                    <option>Martedì</option>
                    <option>Mercoledì</option>
                    <option>Giovedì</option>
                    <option>Venerdì</option>
                    <option>Sabato</option>
                    <option>Domenica</option>
                </select>
                :
                <select id="ddlOInizio">
                    <option>00</option>
                    <option>30</option>
                </select>
            </td>
        </tr>
        <tr>
            <td><label id="lblFine" /></td>
            <td>
                <select id="ddlDFine">
                    <option>Lunedì</option>
                    <option>Martedì</option>
                    <option>Mercoledì</option>
                    <option>Giovedì</option>
                    <option>Venerdì</option>
                    <option>Sabato</option>
                    <option>Domenica</option>
                </select>
                :
                <select id="ddlOFine">
                    <option>00</option>
                    <option>30</option>
                </select>
            </td>
        </tr>
        <tr>
            <td colspan="3" style="text-align:center;">
                <button type="button" id="saveOrario" class="btn">Salva Orario</button>
            </td>
        </tr>
    </table>
</div>