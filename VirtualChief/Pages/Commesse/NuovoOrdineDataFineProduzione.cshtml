@page
@model VirtualChief.Pages.Commesse.NuovoOrdineDataFineProduzioneModel
@{
    ViewData["Title"] = "Data Fine Produzione";
}

<div class="container">
    <nav aria-label="breadcrumb" class="mt-3 mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="/Commesse/commesse">@Model.NavCommesse</a>
            </li>
            <li class="breadcrumb-item">
                <a href="/Commesse/NuovoOrdine">@Model.NavNuovoOrdine</a>
            </li>
            <li class="breadcrumb-item">
                <a href="/Commesse/NuovoOrdineProdotti?idCommessa=@Model.IdCommessa&annoCommessa=@Model.AnnoCommessa">@Model.NavProdotti</a>
            </li>
            <li class="breadcrumb-item">
                <a href="/Commesse/NuovoOrdineReparto?idCommessa=@Model.IdCommessa&annoCommessa=@Model.AnnoCommessa&idProdotto=@Model.IdProdotto&annoProdotto=@Model.AnnoProdotto">@Model.NavReparto</a>
            </li>
            <li class="breadcrumb-item">
                <a href="/Commesse/NuovoOrdineTasks?idCommessa=@Model.IdCommessa&annoCommessa=@Model.AnnoCommessa&idProdotto=@Model.IdProdotto&annoProdotto=@Model.AnnoProdotto">@Model.NavTasks</a>
            </li>
            <li class="breadcrumb-item">
                <a href="/Commesse/NuovoOrdineDataConsegna?idCommessa=@Model.IdCommessa&annoCommessa=@Model.AnnoCommessa&idProc=@Model.IdProc&revProc=@Model.RevProc&idVariante=@Model.IdVariante&idReparto=@Model.IdReparto&idProdotto=@Model.IdProdotto&annoProdotto=@Model.AnnoProdotto&quantita=@Model.Quantita">@Model.NavDataConsegna</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">@Model.NavDataFineProduzione</li>
        </ol>
    </nav>

    <h1>@Model.NavDataFineProduzione</h1>

    @if (!Model.HasPermission)
    {
        <div class="alert alert-warning">@Model.PermissionDeniedMessage</div>
    }
    else if (Model.Articolo == null)
    {
        <div class="alert alert-danger">Articolo non trovato.</div>
    }
    else
    {
        <div class="card mb-3">
            <div class="card-header">
                <h5>@Model.InfoPanelTitle</h5>
            </div>
            <div class="card-body">
                <component type="typeof(Components.Commesse.WizardInfoPanel)" 
                           param-Tenant="@Model.Tenant"
                           param-IdCommessa="@Model.IdCommessa"
                           param-AnnoCommessa="@Model.AnnoCommessa"
                           param-IdProc="@Model.IdProc"
                           param-RevProc="@Model.RevProc"
                           param-IdVariante="@Model.IdVariante"
                           param-IdProdotto="@Model.IdProdotto"
                           param-AnnoProdotto="@Model.AnnoProdotto"
                           param-IdReparto="@Model.IdReparto"
                           render-mode="ServerPrerendered" />
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h5>@Model.DataFineProduzioneTitle</h5>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger">@Model.ErrorMessage</div>
                }

                @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                {
                    <div class="alert alert-success">@Model.SuccessMessage</div>
                }

                @if (Model.Articolo.Status == 'I' || Model.Articolo.Status == 'P')
                {
                    <div class="alert alert-info">
                        <h5>@Model.AlreadyInProductionTitle</h5>
                        <p>@Model.AlreadyInProductionMessage</p>
                        <ul>
                            <li><strong>@Model.DataFineProdLabel:</strong> @Model.Articolo.DataPrevistaFineProduzione.ToString("dd/MM/yyyy HH:mm:ss")</li>
                            <li><strong>@Model.DataConsegnaLabel:</strong> @Model.Articolo.DataPrevistaConsegna.ToString("dd/MM/yyyy HH:mm:ss")</li>
                        </ul>
                        
                        @if (Model.Articolo.DataPrevistaFineProduzione <= Model.Articolo.DataPrevistaConsegna && Model.Articolo.DataPrevistaFineProduzione >= DateTime.Now)
                        {
                            <form method="post">
                                <input type="hidden" name="action" value="reschedule" />
                                <button type="submit" class="btn btn-primary" onclick="return confirm('@Model.ConfirmLaunchMessage');">
                                    <img src="/img/iconProductionLaunch.png" height="20" /> @Model.RescheduleButton
                                </button>
                                <a href="@Model.BackUrl" class="btn btn-secondary ms-2">
                                    <img src="/img/iconArrowLeft.png" height="20" /> @Model.BackButton
                                </a>
                            </form>
                        }
                        else
                        {
                            <div class="alert alert-warning">@Model.InvalidDatesMessage</div>
                            <a href="@Model.BackUrl" class="btn btn-secondary">
                                <img src="/img/iconArrowLeft.png" height="20" /> @Model.BackButton
                            </a>
                        }
                    </div>
                }
                else
                {
                    <form method="post">
                        <div class="row">
                            <div class="col-md-2 text-center">
                                <a href="@Model.BackUrl" class="btn btn-link p-0" title="@Model.BackTooltip">
                                    <img src="/img/iconArrowLeft.png" height="40" />
                                </a>
                            </div>
                            <div class="col-md-8">
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label for="calFineProd" class="form-label">@Model.DataFineProdLabel</label>
                                        <input type="date" id="calFineProd" name="productionEndDate" class="form-control" value="@Model.SelectedDateString" required min="@DateTime.Today.ToString("yyyy-MM-dd")" max="@Model.MaxDateString" />
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">@Model.OreLabel / @Model.MinutiLabel / @Model.SecondiLabel</label>
                                        <div class="d-flex gap-2">
                                            <select name="productionEndHour" class="form-select" style="width: 80px;">
                                                @for (int i = 0; i < 24; i++)
                                                {
                                                    <option value="@i" selected="@(Model.SelectedHour == i)">@i.ToString("D2")</option>
                                                }
                                            </select>
                                            <select name="productionEndMinute" class="form-select" style="width: 80px;">
                                                @for (int i = 0; i < 60; i++)
                                                {
                                                    <option value="@i" selected="@(Model.SelectedMinute == i)">@i.ToString("D2")</option>
                                                }
                                            </select>
                                            <select name="productionEndSecond" class="form-select" style="width: 80px;">
                                                @for (int i = 0; i < 60; i++)
                                                {
                                                    <option value="@i" selected="@(Model.SelectedSecond == i)">@i.ToString("D2")</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="d-flex gap-2">
                                    <button type="submit" name="action" value="saveDate" class="btn btn-primary">
                                        <img src="/img/iconSave.jpg" height="20" /> @Model.SaveButton
                                    </button>
                                </div>
                            </div>
                            <div class="col-md-2 text-center">
                                <button type="submit" name="action" value="launch" class="btn btn-success" disabled="@(!Model.CanLaunch)" onclick="return confirm('@Model.ConfirmLaunchMessage');">
                                    <img src="/img/iconArrowRight.png" height="40" />
                                </button>
                            </div>
                        </div>
                    </form>
                }
            </div>
        </div>
    }
</div>