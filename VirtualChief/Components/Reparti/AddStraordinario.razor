@using KIS.App_Code
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Dapper
@using MySql.Data.MySqlClient
@inject ILogger<AddStraordinario> Logger
@inject NavigationManager NavigationManager

@if (!HasPermission)
{
    <div class="alert alert-warning">@PermissionDeniedMessage</div>
}
else if (Turno == null)
{
    <div class="alert alert-danger">@TurnoNotFoundMessage</div>
}
else
{
    <h3>@Title</h3>

    <div class="card">
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label">@InizioLabel</label>
                    <input type="date" class="form-control" @bind="InizioDate" @bind:event="onchange" />
                    <div class="row mt-2">
                        <div class="col-6">
                            <label class="form-label">@OraLabel</label>
                            <select class="form-select" @bind="InizioOra">
                                @for (int i = 0; i < 24; i++)
                                {
                                    <option value="@i">@i.ToString("D2")</option>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label">@MinutoLabel</label>
                            <select class="form-select" @bind="InizioMinuto">
                                @for (int i = 0; i < 60; i++)
                                {
                                    <option value="@i">@i.ToString("D2")</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label">@FineLabel</label>
                    <input type="date" class="form-control" @bind="FineDate" @bind:event="onchange" />
                    <div class="row mt-2">
                        <div class="col-6">
                            <label class="form-label">@OraLabel</label>
                            <select class="form-select" @bind="FineOra">
                                @for (int i = 0; i < 24; i++)
                                {
                                    <option value="@i">@i.ToString("D2")</option>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label">@MinutoLabel</label>
                            <select class="form-select" @bind="FineMinuto">
                                @for (int i = 0; i < 60; i++)
                                {
                                    <option value="@i">@i.ToString("D2")</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mb-3">
                <button class="btn btn-success" @onclick="Save" disabled="@IsSaving">
                    @if (IsSaving) { <span class="spinner-border spinner-border-sm"></span> }
                    <img src="/img/iconSave.jpg" height="40" /> @SaveLabel
                </button>
                <button class="btn btn-secondary" @onclick="Reset" disabled="@IsSaving">
                    <img src="/img/iconUndo.png" height="40" /> @ResetLabel
                </button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger mt-3">@ErrorMessage</div>
    }
    @if (!string.IsNullOrEmpty(SuccessMessage))
    {
        <div class="alert alert-success mt-3">@SuccessMessage</div>
    }
}

@code {
    [Parameter]
    public string Tenant { get; set; }

    [Parameter]
    public bool HasPermission { get; set; } = false;

    [Parameter]
    public int TurnoId { get; set; }

    public string Title { get; set; } = "Aggiungi Straordinario";
    public string InizioLabel { get; set; } = "Inizio";
    public string FineLabel { get; set; } = "Fine";
    public string OraLabel { get; set; } = "Ora";
    public string MinutoLabel { get; set; } = "Minuto";
    public string SaveLabel { get; set; } = "Salva";
    public string ResetLabel { get; set; } = "Annulla";
    public string PermissionDeniedMessage { get; set; } = "Non hai il permesso di aggiungere straordinari";
    public string TurnoNotFoundMessage { get; set; } = "Turno non trovato";
    public string ErrorInputMessage { get; set; } = "Data/ora non valida: l'inizio deve essere prima della fine e nel futuro";
    public string ErrorSovrapposizioneMessage { get; set; } = "Sovrapposizione con altro straordinario";
    public string SaveSuccessMessage { get; set; } = "Straordinario aggiunto con successo";
    public string SaveErrorMessage { get; set; } = "Errore durante il salvataggio";
    public string ErrorMessage { get; set; } = "";
    public string SuccessMessage { get; set; } = "";

    public Turno Turno { get; set; }
    public Reparto Reparto { get; set; }

    public DateTime InizioDate { get; set; } = DateTime.Today.AddDays(1);
    public DateTime FineDate { get; set; } = DateTime.Today.AddDays(1);
    public int InizioOra { get; set; } = 0;
    public int InizioMinuto { get; set; } = 0;
    public int FineOra { get; set; } = 0;
    public int FineMinuto { get; set; } = 0;
    public bool IsSaving { get; set; } = false;

    protected override void OnInitialized()
    {
        LoadResources();
        if (TurnoId != 0)
        {
            LoadTurno();
        }
    }

    protected override void OnParametersSet()
    {
        if (TurnoId != 0)
        {
            LoadTurno();
        }
    }

    private void LoadResources()
    {
        Title = "Aggiungi Straordinario";
        InizioLabel = "Inizio";
        FineLabel = "Fine";
        OraLabel = "Ora";
        MinutoLabel = "Minuto";
        SaveLabel = "Salva";
        ResetLabel = "Annulla";
        PermissionDeniedMessage = "Non hai il permesso di aggiungere straordinari";
        TurnoNotFoundMessage = "Turno non trovato";
        ErrorInputMessage = "Data/ora non valida: l'inizio deve essere prima della fine e nel futuro";
        ErrorSovrapposizioneMessage = "Sovrapposizione con altro straordinario";
        SaveSuccessMessage = "Straordinario aggiunto con successo";
        SaveErrorMessage = "Errore durante il salvataggio";
    }

    private void LoadTurno()
    {
        if (string.IsNullOrEmpty(Tenant) || !HasPermission || TurnoId == 0)
        {
            Turno = null;
            return;
        }

        try
        {
            Turno = new Turno(Tenant, TurnoId);
            if (Turno.id != -1)
            {
                Reparto = new Reparto(Tenant, Turno.idReparto);
            }
            else
            {
                Turno = null;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading turno {TurnoId}", TurnoId);
            Turno = null;
        }
    }

private void Save()
        {
            ErrorMessage = "";
            SuccessMessage = "";

            var inizio = new DateTime(InizioDate.Year, InizioDate.Month, InizioDate.Day, InizioOra, InizioMinuto, 0);
            var fine = new DateTime(FineDate.Year, FineDate.Month, FineDate.Day, FineOra, FineMinuto, 0);

            var now = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, Reparto?.tzFusoOrario ?? TimeZoneInfo.Utc);
            
            if (inizio >= fine || inizio <= now)
            {
                ErrorMessage = ErrorInputMessage;
                return;
            }

            IsSaving = true;

            try
            {
                if (Turno == null || Reparto == null)
                {
                    ErrorMessage = TurnoNotFoundMessage;
                    return;
                }

                // Convert to UTC using reparto timezone
                var rp = new Reparto(Tenant, Reparto.id);
                var i = TimeZoneInfo.ConvertTimeToUtc(inizio, rp.tzFusoOrario);
                var f = TimeZoneInfo.ConvertTimeToUtc(fine, rp.tzFusoOrario);

                if (i >= f)
                {
                    ErrorMessage = ErrorInputMessage;
                    return;
                }

                // Check for overlaps with existing straordinari/festivita for this turno
                using (var conn = (new Dati.Dati()).mycon(Tenant))
                {
                    conn.Open();

                    // Check overlap with existing straordinari/festivita
                    var overlap = conn.Query<int>(@"
                        SELECT sfi.id 
                        FROM straordinarifestivita sfi
                        INNER JOIN turniproduzione tp ON tp.id = sfi.turno
                        WHERE tp.reparto = @idReparto 
                        AND sfi.turno = @idTurno
                        AND ((sfi.datainizio < @i AND @i < sfi.datafine)
                            OR (sfi.datainizio < @f AND @f < sfi.datafine)
                            OR (@i < sfi.datainizio AND sfi.datafine < @f))", 
                        new { idReparto = Reparto.id, idTurno = Turno.id, i = i.ToString("yyyy-MM-dd HH:mm:ss"), f = f.ToString("yyyy-MM-dd HH:mm:ss") });

                    if (overlap.Any())
                    {
                        ErrorMessage = ErrorSovrapposizioneMessage;
                        return;
                    }

                    // Check overlap with turni calendar
                    var crp = new CalendarioReparto(Tenant, Reparto.id, i.AddDays(-3), f.AddDays(3));
                    bool check2 = false;
                    foreach (var turnoCal in crp.Turni)
                    {
                        var inizioTurno = TimeZoneInfo.ConvertTimeToUtc(turnoCal.Inizio, rp.tzFusoOrario);
                        var fineTurno = TimeZoneInfo.ConvertTimeToUtc(turnoCal.Fine, rp.tzFusoOrario);
                        if (inizioTurno <= i && i <= fineTurno && inizioTurno <= f && f <= fineTurno)
                        {
                            check2 = true;
                            break;
                        }
                    }

                    if (!check2)
                    {
                        ErrorMessage = ErrorSovrapposizioneMessage;
                        return;
                    }

                    // Insert the straordinario
                    var maxId = conn.ExecuteScalar<int?>("SELECT MAX(id) FROM straordinarifestivita");
                    int newId = (maxId ?? 0) + 1;

                    int ret = conn.Execute(@"
                        INSERT INTO straordinarifestivita (id, turno, datainizio, datafine, azione)
                        VALUES (@id, @turno, @datainizio, @datafine, 'S')",
                        new { id = newId, turno = Turno.id, datainizio = i.ToString("yyyy-MM-dd HH:mm:ss"), datafine = f.ToString("yyyy-MM-dd HH:mm:ss") });

                    if (ret > 0)
                    {
                        SuccessMessage = SaveSuccessMessage;
                        NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
                    }
                    else
                    {
                        ErrorMessage = ErrorSovrapposizioneMessage;
                    }
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error saving straordinario for turno {TurnoId}", TurnoId);
                ErrorMessage = SaveErrorMessage;
            }
            finally
            {
                IsSaving = false;
            }
        }

    private void Reset()
    {
        InizioDate = DateTime.Today.AddDays(1);
        FineDate = DateTime.Today.AddDays(1);
        InizioOra = 0;
        InizioMinuto = 0;
        FineOra = 0;
        FineMinuto = 0;
        ErrorMessage = "";
        SuccessMessage = "";
    }
}