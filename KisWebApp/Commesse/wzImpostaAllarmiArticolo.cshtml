<label id="lblImpostaAllarmi2" />
<table id="tblAlarms" style="display:none;">
    <tr>
        <td>@Html.Partial("~/Eventi/ArticoloRitardo.cshtml")</td>
        <td>
            @Html.Partial("~/Eventi/ArticoloWarning.cshtml")
