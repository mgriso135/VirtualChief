@inherits KIS.Personal.myChangePassword
@{
    // placeholder – markup reproduced from myChangePassword.ascx
}
<label id="lbl1" />
<table id="tblChangePassword">
    <tr>
        <td><label id="lblOldPassword" /></td>
        <td><input type="password" id="txtOldPassword" required />
            <span style="color:red;"><label id="lblCampoObbligatorio" /></span>
        </td>
    </tr>
    <tr>
        <td><label id="lblNewPassword" /></td>
        <td><input type="password" id="txtNewPassword1" required />
            <span style="color:red;"><label id="lblCampoObbligatorio2" /></span>
        </td>
    </tr>
    <tr>
        <td><label id="lblRipetiNewPassword" /></td>
        <td><input type="password" id="txtNewPassword2" required />
            <span style="color:red;"><label id="lblCampoObbligatorio3" /></span>
        </td>
    </tr>
    <tr>
        <td colspan="2">
            <button type="button" id="imgSavePassword" class="btn btn-success" onclick="doChange()">Salva</button>
            <button type="button" id="imgUndoPassword" class="btn">Annulla</button>
        </td>
    </tr>
</table>

<script type="text/javascript">
    function doChange() {
        if (!$("#txtOldPassword").val() || !$("#txtNewPassword1").val() || !$("#txtNewPassword2").val()) {
            alert("Compilare tutti i campi obbligatori");
            return;
        }
        if ($("#txtNewPassword1").val() !== $("#txtNewPassword2").val()) {
            alert("Le password non coincidono");
            return;
        }
        alert("Password modificata");
    }
</script>