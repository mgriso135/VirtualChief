<script type="text/javascript">
    function toggleEdit() {
        $(".table-condensed input, .table-condensed textarea").prop("disabled", function (i, v) { return !v; });
    }
    function doNewRevision() { alert("Nuova revisione"); }
    function doNewRevisionCopy() { alert("Copia nuova revisione"); }
    function doDeleteProcess() { if (confirm("Eliminare il processo?")) alert("Processo eliminato"); }
    function doSave() { alert("Modifiche salvate"); }
    function doAddVariante() { alert("Variante aggiunta"); }
    function doCopy() { alert("Copia effettuata"); }
    function toggleEditVariante() { alert("Modifica variante"); }
    function doDeleteVariante() { if (confirm("Eliminare la variante?")) alert("Variante eliminata"); }
</script>