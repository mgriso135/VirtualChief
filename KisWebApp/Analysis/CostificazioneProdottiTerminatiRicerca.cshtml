@inherits KIS.Analysis.CostificazioneProdottiTerminatiRicerca1
@{
    // placeholder – markup reproduced from CostificazioneProdottiTerminatiRicerca.ascx (control wins over _OLD.aspx page)
}
<script type="text/javascript">
    $(function () {
        $("#txtProductDateStart").datepicker({ dateFormat: 'dd/mm/yy' });
    });
    $(function () {
        $("#txtProductDateEnd").datepicker({ dateFormat: 'dd/mm/yy' });
    });
</script>
<label id="lbl1" />
<table id="tblRicerca" class="table table-striped table-hover">
    <tr>
        <td>
            <input type="radio" name="ModRicerca" id="uno" value="uno" checked="checked" />
        </td>
        <td><label id="lblRicercaPerIDProd" />
            <input type="text" id="txtIDArticolo" placeholder="" style="width:70px;" title="" />/<input type="text" id="txtAnnoArticolo" placeholder="" title="" />
        </td>
    </tr>
    <tr>
        <td style="vertical-align: top"><input type="radio" name="ModRicerca" id="due" value="due" /></td>
        <td style="vertical-align:middle;"><label id="lblRicercaPerProdCliente" /><br />
            <label id="lblProdotto" />&nbsp;<select id="ddlTipoProdotto"><option value="-1/-1/-1"></option></select><br />
            <label id="lblCliente" />&nbsp;<select id="ddlCliente"><option value=""></option></select><br />
            <input type="checkbox" id="chkConsideraDate" /><label id="lblFiltroDataProd1" />
            <input type="text" id="txtProductDateStart" style="width:100px;" />&nbsp;<label id="lblFiltroDataProd2" />&nbsp;<input type="text" id="txtProductDateEnd" style="width:100px;" />
        </td>
    </tr>
    <tr>
        <td colspan="2">
            <button type="button" id="imgSearch" class="btn-link" onclick="doSearch()"><img src="~/img/iconView.png" height="40" /></button>RICERCA!
        </td>
    </tr>
</table>
<div id="rptArticoliTerminati">
