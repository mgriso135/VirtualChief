                    var rows = conn.Query<(int commessaid, int commessaanno)>("SELECT commessaid, commessaanno FROM eventocommessagruppi WHERE "
                        + "TipoEvento LIKE 'Warning' AND idGruppo = @ID", new { ID = this.ID });
