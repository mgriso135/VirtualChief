@inherits KIS.Login.forgotPassword
@{
    // placeholder – markup reproduced from forgotPassword.ascx
}
<p class="text-info"><label id="lblDisclaimer" /></p>
<label id="lblUsername" />:&nbsp;<input type="text" id="txtUsername" required />
<button type="button" id="btnUsername" class="btn" onclick="doReset()">Reset password</button>
<span style="color:red;"><label id="lblValReqField" /></span>
<br />
<label id="lbl1" class="text-info" />

<script type="text/javascript">
    function doReset() {
        if (!$("#txtUsername").val()) {
            alert("Compilare tutti i campi obbligatori");
            return;
        }
        alert("Password resettata");
    }
</script>