@inherits KIS.Reparti.configKanban
@{
    // placeholder – markup reproduced from configKanban.ascx
}
<div class="row-fluid">
    <div class="span12">
        <label id="lbl1" />
        <br />
        <div class="radio">
            <label>
                <input type="radio" id="rb1_0" name="rb1" /> <%= Resources.lblKBNonEnabled %>
            </label>
            <label>
                <input type="radio" id="rb1_1" name="rb1" /> <%= Resources.lblKBEnabled %>
            </label>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(function () {
        // Original used AutoPostBack + SelectedIndexChanged; here we just log change.
        $("input[name='rb1']").change(function () {
            alert("Selection changed to: " + $(this).val());
        });
    });
</script>