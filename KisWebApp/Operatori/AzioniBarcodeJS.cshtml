        function pback() {
            document.getElementById('action').value = "ManageTasks";
            document.forms[0].submit();
        }

        function FirePrompt() {
            if (gettingData != true) {
                var retVal = prompt('Quantità prodotta', "")
                if (retVal) {
                    document.getElementById('action').value = "ChangeQuantity";
                    var retInt = parseInt(retVal);
                    if (isNaN(retInt)) {
                        alert('Errore nel formato della quantità');
                        var tbox = document.getElementById("box1");
                        tbox.focus();
                        return false;
                    }
                    else {
                        document.getElementById('newQtyFld').value = retInt.toString();
                        document.forms[0].submit();
                        return true;
                    }
                }
                else {
                    var tbox = document.getElementById("box1");
                    tbox.focus();
