            <td></td>
            <td style="border-left:1px dashed blue; text-align:center;">
                <label id="litConstraintType2" /><select id="newSuccConstraint">
                    <option value="0">FS</option>
                    <option value="1">SS</option>
                </select><br />
                <label id="litTaskSucc" /><select id="newSucc">
                    <option>Task A</option>
                    <option>Task B</option>
                </select>
            </td>
        </tr>
    </tfoot>
