@inherits KIS.Configuration.wizConfigReparti_Main1
@{
    // placeholder – markup reproduced from wizConfigReparti_Main.ascx
}
<h3><label id="lblTitleAddReparto" /></h3>
<label id="lbl1" class="text-info" />
<table id="frmAddReparto" class="table">
    <tr>
        <td><label id="lblNome" />:</td>
        <td><input type="text" id="nome" required />
            <span style="color:red;"><label id="lblValReqField" /></span>
        </td>
    </tr>
    <tr>
        <td><label id="lblDesc" />:</td>
        <td><textarea id="descrizione" rows="4" required></textarea>
            <span style="color:red;"><label id="lblValReqField2" /></span>
        </td>
    </tr>
    <tr>
        <td><label id="lblTimezone" />:</td>
        <td><select id="ddlTimezones"><option value="">--</option><option value="Europe/Rome">Europe/Rome</option></select></td>
    </tr>
    <tr>
        <td colspan="2">
            <button type="button" id="save" class="btn btn-success" onclick="doSave()">Salva</button>
            <button type="button" id="reset" class="btn">Annulla</button>
        </td>
    </tr>
</table>

<table class="table table-striped table-condensed">
    <thead>
        <th><label id="lblReparto" /></th>
        <th><label id="lblConfigurato" /></th>
        <th><label id="lblConfigura" /></th>
    </thead>
    <!-- Items generated by code‑behind / AJAX -->
</table>

<script type="text/javascript">
    function doSave() {
        if (!$("#nome").val() || !$("#descrizione").val()) {
            alert("Compilare tutti i campi obbligatori");
            return;
        }
        alert("Reparto aggiunto");
    }
</script>