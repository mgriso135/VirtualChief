@inherits KIS.Personal.myEmail
@{
    // placeholder – markup reproduced from myEmail.ascx
}
<button type="button" id="imgShowFormAddEmail" class="btn-link">+</button>
<label id="lblAddEmail" />
<table id="frmAddEmail" class="table table-bordered table-hover table-condensed">
    <thead>
        <tr>
            <th><label id="lblEmail" /></th>
            <th><label id="lblAmbito" /></th>
            <th><label id="lblAlarmBox" /></th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td><input type="email" id="txtEmail" required /><br />
                <span style="color:red;"><label id="valEmail" /></span>
            </td>
            <td><input type="text" id="txtAmbito" required /><br />
                <span style="color:red;"><label id="valAmbito" /></span>
            </td>
            <td><input type="checkbox" id="chkForAlarm" /></td>
            <td>
                <button type="button" id="imgSaveMail" class="btn btn-success">Salva</button>
                <button type="button" id="imgUndoMail" class="btn">Annulla</button>
            </td>
        </tr>
    </tbody>
</table>
<label id="lbl1" />
<table class="table table-striped table-hover table-condensed">
    <thead>
        <tr>
            <th></th>
            <th><label id="lblHeadEmail" /></th>
            <th><label id="lblHeadAmbito" /></th>
            <th><label id="lblHeadForAlarm" /></th>
        </tr>
    </thead>
    <tbody>
        <!-- Items generated by code‑behind / AJAX -->
    </tbody>
</table>

<script type="text/javascript">
    $(function () {
        $("#imgSaveMail").click(function () {
            if (!$("#txtEmail").val() || !$("#txtAmbito").val()) {
                alert("Compilare tutti i campi obbligatori");
                return;
            }
            alert("Email aggiunta");
        });
    });
</script>