@inherits KIS.Produzione.configTurni
@{
    // placeholder – markup reproduced from configTurni.ascx
}
<div class="row-fluid">
    <div class="span12">
        <h3><label id="lblTitleTurni" /></h3>
    </div>
</div>

<br />

<div class="row-fluid">
    <div class="span12">
        <table class="table table-striped table-hover table-condensed">
            <thead>
                <tr>
                    <th></th>
                    <th><label id="lblTurno" /></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <!-- Items generated by code‑behind or AJAX -->
                <tr>
                    <td><button class="btn btn-danger btn-sm">Cancella</button></td>
                    <td>Turno Example</td>
                    <td><a class="btn btn-link" href="#">Gestisci</a></td>
                </tr>
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="3" style="text-align:center;">
                        <button class="btn">Add Turno</button>
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<br />

<div class="row-fluid">
    <div class="span12">
        <table class="table table-bordered">
            <tr>
                <td><label id="lblNomeTurno" />: <input type="text" id="nomeTurno" /></td>
            </tr>
            <tr>
                <td><label id="lblColore" />: <select id="coloreTurno"><option>Red</option><option>Blue</option></select></td>
            </tr>
            <tr>
                <td style="text-align:center;">
                    <button type="button" id="save" class="btn">Salva</button>
                    <button type="button" id="reset" class="btn">Annulla</button>
                </td>
            </tr>
        </table>
    </div>
</div>

<script type="text/javascript">
    $(function () {
        // Simple replacement for postback; original used AsyncPostBackTrigger etc.
        $("#save").click(function () {
            // simulate save
            alert("Turno salvato");
        });
        $("#reset").click(function () {
            $("#nomeTurno").val("");
        });
    });
</script>