@inherits KIS.kpi.admin
@{
    // placeholder – markup reproduced from admin.aspx
}
<ul class="breadcrumb hidden-phone">
    <li>
        <a href="#">Admin</a>
        <span class="divider">/</span>
    </li>
</ul>

<div class="page-header">
