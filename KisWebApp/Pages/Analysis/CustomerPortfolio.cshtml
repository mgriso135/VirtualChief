@page
@model KisWebApp.Pages.Analysis.CustomerPortfolioModel
@{
    ViewData["Title"] = "Customer Portfolio";
}

<div class="card">
    <div class="card-body">
        <h5 class="card-title">Customer Portfolio</h5>
        
        @if (Model.Customers != null && Model.Customers.Count > 0)
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Customer</th>
                        <th>Revenue</th>
                        <th>Order History</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var customer in Model.Customers)
                    {
                        <tr>
                            <td>@customer.Name</td>
                            <td>@customer.Revenue</td>
                            <td>@customer.OrderHistory</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p>No customers found or permission denied</p>
        }
    </div>
</div>