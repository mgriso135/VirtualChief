@using KIS.App_Code
@using KIS.App_Sources
@using Microsoft.AspNetCore.Components
@inject ILogger<PrintBarcodes> Logger
@inject NavigationManager NavigationManager
@inject HttpClient HttpClient

@if (!HasPermission)
{
    <div class="alert alert-warning">@PermissionDeniedMessage</div>
}
else if (Articolo == null)
{
    <div class="text-muted">Seleziona un articolo per stampare i barcode.</div>
}
else
{
    <div class="accordion" id="printBarcodesAccordion">
        <div class="accordion-item">
            <h2 class="accordion-header" id="headingOne">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapsePrint" aria-expanded="false" aria-controls="collapsePrint">
                    @StampaBarcodesLabel
                </button>
            </h2>
            <div id="collapsePrint" class="accordion-collapse collapse" aria-labelledby="headingOne" data-bs-parent="#printBarcodesAccordion">
                <div class="accordion-body">
                    <div class="d-flex gap-3 flex-wrap">
                        <button type="button" class="btn btn-outline-primary" @onclick="PrintMultiA4" disabled="@IsPrinting" title="@StampaMultiA4Tooltip">
                            <img src="/img/iconBarcodeDoppio.png" width="40" height="40" />
                            <div>@StampaMultiA4Label</div>
                        </button>
                        <button type="button" class="btn btn-outline-primary" @onclick="PrintSingleA4" disabled="@IsPrinting" title="@StampaSingoloA4Tooltip">
                            <img src="/img/iconBarcode.png" height="40" />
                            <div>@StampaSingoloA4Label</div>
                        </button>
                        <button type="button" class="btn btn-outline-secondary" @onclick="PrintSingleA3" disabled="@IsPrinting" title="@StampaSingoloA3Tooltip">
                            <img src="/img/iconA3.gif" height="40" />
                            <div>@StampaSingoloA3Label</div>
                        </button>
                    </div>

                    @if (IsPrinting)
                    {
                        <div class="text-center mt-3">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Generazione PDF in corso...</span>
                            </div>
                            <p class="mt-2">@GeneratingMessage</p>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <div class="alert alert-danger mt-3">@ErrorMessage</div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public string Tenant { get; set; }

    [Parameter]
    public int IdArticolo { get; set; }

    [Parameter]
    public int AnnoArticolo { get; set; }

    [Parameter]
    public bool HasPermission { get; set; } = false;

    public string StampaBarcodesLabel { get; set; } = "Stampa Barcode";
    public string StampaMultiA4Label { get; set; } = "Stampa Fogli Multipli A4";
    public string StampaSingoloA4Label { get; set; } = "Stampa Fogli Singoli A4";
    public string StampaSingoloA3Label { get; set; } = "Stampa Fogli Singoli A3";
    public string StampaMultiA4Tooltip { get; set; } = "Stampa tutti i task su fogli A4 multipli";
    public string StampaSingoloA4Tooltip { get; set; } = "Stampa ogni task su un foglio A4 separato";
    public string StampaSingoloA3Tooltip { get; set; } = "Stampa su foglio A3 orizzontale";
    public string GeneratingMessage { get; set; } = "Generazione PDF in corso...";
    public string PermissionDeniedMessage { get; set; } = "Non hai il permesso di stampare i barcode.";
    public string ErrorMessage { get; set; } = "";

    public bool IsPrinting { get; set; } = false;

    public Articolo Articolo { get; set; }

    protected override void OnInitialized()
    {
        LoadResources();
        LoadArticolo();
    }

    protected override void OnParametersSet()
    {
        LoadArticolo();
    }

    private void LoadResources()
    {
        StampaBarcodesLabel = "Stampa Barcode";
        StampaMultiA4Label = "Stampa Fogli Multipli A4";
        StampaSingoloA4Label = "Stampa Fogli Singoli A4";
        StampaSingoloA3Label = "Stampa Fogli Singoli A3";
        StampaMultiA4Tooltip = "Stampa tutti i task su fogli A4 multipli";
        StampaSingoloA4Tooltip = "Stampa ogni task su un foglio A4 separato";
        StampaSingoloA3Tooltip = "Stampa su foglio A3 orizzontale";
        GeneratingMessage = "Generazione PDF in corso...";
        PermissionDeniedMessage = "Non hai il permesso di stampare i barcode.";
    }

    private void LoadArticolo()
    {
        if (string.IsNullOrEmpty(Tenant) || IdArticolo <= 0 || AnnoArticolo <= 0)
        {
            Articolo = null;
            return;
        }

        try
        {
            Articolo = new Articolo(Tenant, IdArticolo, AnnoArticolo);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "PrintBarcodes: Error loading article {Id}/{Year}", IdArticolo, AnnoArticolo);
            Articolo = null;
        }
    }

    private async Task PrintMultiA4()
    {
        await PrintBarcode("multiA4");
    }

    private async Task PrintSingleA4()
    {
        await PrintBarcode("singleA4");
    }

    private async Task PrintSingleA3()
    {
        await PrintBarcode("singleA3");
    }

    private async Task PrintBarcode(string type)
    {
        if (Articolo == null || string.IsNullOrEmpty(Tenant))
            return;

        try
        {
            IsPrinting = true;
            ErrorMessage = "";

            var response = await HttpClient.PostAsync($"api/commesse/{Articolo.ID}/{Articolo.Year}/barcode/{type}", null);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<BarcodePrintResult>();
                if (result?.Success == true && !string.IsNullOrEmpty(result.PdfUrl))
                {
                    NavigationManager.NavigateTo(result.PdfUrl, forceLoad: false);
                }
                else
                {
                    ErrorMessage = result?.Message ?? "Errore durante la generazione del PDF";
                }
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorResponse>();
                ErrorMessage = error?.Error ?? "Errore durante la generazione del PDF";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "PrintBarcodes: Error generating barcode PDF type {Type}", type);
            ErrorMessage = "Errore generico durante la generazione del PDF";
        }
        finally
        {
            IsPrinting = false;
        }
    }

    private class BarcodePrintResult
    {
        public bool Success { get; set; }
        public string PdfUrl { get; set; }
        public string Message { get; set; }
    }

    private class ErrorResponse
    {
        public string Error { get; set; }
        public string Details { get; set; }
    }
}