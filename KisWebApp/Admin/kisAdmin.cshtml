@inherits KIS.Admin.kisAdmin
@{
    // placeholder – markup reproduced from kisAdmin.aspx
}
<script>
    $(document).ready(function () {
        function loadRemoteSalesOrders() {
            $.ajax({
                url: "../Config/Config/SalesOrderImport3PartySystemActive",
                type: 'POST',
                dataType: "html",
                data: {},
                success: function (result) {
                    $("#frmRemoteSalesOrders").html(result);
                    $("#imgLoadRemoteSalesOrders").fadeOut();
                },
                error: function (result) {
                    $("#imgLoadRemoteSalesOrders").fadeOut();
                }
            });
        }
        $("#imgLoadRemoteSalesOrders").fadeIn();
        loadRemoteSalesOrders();
    });
</script>
<ul class="breadcrumb hidden-phone">
    <li>
        <a href="../Admin/admin.cshtml"><label id="lblNavAdmin" /></a>
        <span class="divider">/</span>
    </li>
    <li>
        <a href="kisAdmin.cshtml"><label id="lblNavSysCfg" /></a>
        <span class="divider">/</span>
    </li>
</ul>
<h1><label id="lblTitleSysCfg" /></h1>
<label id="lbl1" />

<div class="accordion" id="accordion1">
    <div class="accordion-group">
        <div class="accordion-heading">
