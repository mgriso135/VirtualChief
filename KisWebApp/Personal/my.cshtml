@inherits KIS.Personal.my
@{
    // Razor page replacing Personal/my.aspx
}
<div class="row-fluid">
    <div class="span12">
        <ul class="breadcrumb hidden-phone">
            <li><a href="my.aspx"><label id="lblNavYourAccount" /></a><span class="divider">/</span></li>
        </ul>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        function loadDestinationURL() {
            $('#imgLoadDestinationURL').show();
            $.ajax({
                url: "../Personal/PersonalArea/EditDestinationURL",
                type: 'GET',
                dataType: 'html',
                success: function (result) {
                    $('#frmDestinationURL').html(result);
                    $('#imgLoadDestinationURL').hide();
                }
            });
        }
        loadDestinationURL();
    });
</script>

