<label id="lblCheck" />
<table class="table table-striped table-hover" id="tblPrecedenze">
    <thead>
        <tr style="font-weight:bold;">
            <td style="border-right:1px dashed blue; text-align:center;"><label id="lblPrecedenti" /></td>
            <td style="text-align:center;"><label id="lblTaskCorrente" /></td>
            <td style="border-left:1px dashed blue; text-align:center;"><label id="lblSuccessivi" /></td>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td style="border-right:1px dashed blue; text-align:center;">
                <!-- Items generated by code‑behind / AJAX -->
                <a href="updatePERT.aspx?id=1&delID=2&verso=prec&act=delprecedenze&variante=1"><img src="~/img/iconDelete.png" style="min-width:30px; max-width:30px;" /></a>
                Task Precedente (FS)<br />
            </td>
            <td style="text-align:center; font-weight:bold;" id="curr">Task Corrente</td>
            <td style="border-left:1px dashed blue; text-align:center;">
                <!-- Items generated by code‑behind / AJAX -->
                <a href="updatePERT.aspx?id=1&delID=3&verso=succ&act=delprecedenze&variante=1"><img src="~/img/iconDelete.png" style="min-width:30px; max-width:30px;" /></a>
                Task Successivo (FS)<br />
            </td>
        </tr>
    </tbody>
    <tfoot>
        <tr>
            <td style="border-right:1px dashed blue; text-align:center;">
