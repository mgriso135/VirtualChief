@inherits KIS.Clienti.EditContattoDetails1
@{
    // placeholder – markup reproduced from EditContattoDetails.ascx
}
<script type="text/javascript">
    function FireConfirmDelPhone() {
        return confirm("Eliminare il numero di telefono?");
    }
    function FireConfirmDelMail() {
        return confirm("Eliminare l'email?");
    }
</script>

<h3><label id="lblTitleDettagliContatto" /></h3>
<label id="lbl1" />

<div class="row-fluid">
    <div class="span12">
        <table id="tblContatto">
            <tr>
                <td><label id="lblNominativo" />:</td>
                <td><input type="text" id="txtNominativo" maxlength="255" required />
                    <span style="color:red;"><label id="lblReqField" /></span>
                </td>
            </tr>
            <tr>
                <td><label id="lblLastName" />:</td>
                <td><input type="text" id="txtLastName" maxlength="255" required />
                    <span style="color:red;"><label id="lblReqField2" /></span>
                </td>
            </tr>
            <tr>
                <td><label id="lblRuolo" />:</td><td><input type="text" id="txtRuolo" maxlength="255" /></td>
            </tr>
            <tr>
                <td colspan="2" style="text-align:center;">
                    <button type="button" id="btnSave" class="btn btn-success" onclick="doSave()">Salva</button>
                    <button type="button" id="btnUndo" class="btn">Annulla</button>
                </td>
            </tr>
        </table>
    </div>
</div>

<div class="row-fluid">
    <div class="span6">
        <h4><label id="lblNumPhone" /></h4>
        <button type="button" id="btnShowAddPhone" class="btn-link">+</button>
        <table id="frmAddPhone" style="display:none;">
            <tr><td><label id="lblNumPhone2" /></td>
                <td><input type="text" id="txtNewPhone" maxlength="255" required />
                    <span style="color:red;"><label id="lblReqField3" /></span>
                </td>
            </tr>
            <tr>
                <td><label id="lblNote" /></td>
                <td><textarea id="txtNoteNewPhone" rows="4" maxlength="255"></textarea></td>
            </tr>
            <tr>
                <td colspan="2" style="text-align:center;">
                    <button type="button" id="btnNewPhoneSave" class="btn btn-success">Salva</button>
                    <button type="button" id="btnNewPhoneUndo" class="btn">Annulla</button>
                </td>
            </tr>
        </table>

        <table class="table table-condensed table-hover table-striped">
            <thead>
                <td></td>
                <td><label id="lblNumPhone3" /></td>
                <td><label id="lblNote2" /></td>
            </thead>
            <!-- Items generated by code‑behind / AJAX -->
        </table>
    </div>
    <div class="span6">
        <h4><label id="lblTitleEmails" /></h4>
        <button type="button" id="btnShowAddEmail" class="btn-link">+</button>
        <table id="frmAddEmail" style="display:none;">
            <tr><td><label id="lblEmailAddr" /></td>
                <td><input type="email" id="txtNewMail" maxlength="255" required />
                    <span style="color:red;"><label id="lblReqField4" /></span>
                </td>
            </tr>
            <tr>
                <td><label id="lblNote3" /></td>
                <td><textarea id="txtNoteNewMail" rows="4" maxlength="255"></textarea></td>
            </tr>
            <tr>
                <td colspan="2" style="text-align:center;">
                    <button type="button" id="btnNewMailSave" class="btn btn-success">Salva</button>
                    <button type="button" id="btnNewMailUndo" class="btn">Annulla</button>
                </td>
            </tr>
        </table>

        <table class="table table-condensed table-hover table-striped">
            <thead>
                <td></td>
                <td><label id="lblEmailAddr2" /></td>
                <td><label id="lblNote4" /></td>
            </thead>
            <!-- Items generated by code‑behind / AJAX -->
        </table>
    </div>
</div>

<script type="text/javascript">
    function doSave() {
        if (!$("#txtNominativo").val() || !$("#txtLastName").val()) {
            alert("Compilare tutti i campi obbligatori");
            return;
        }
        alert("Contatto salvato");
    }
    $(function () {
        $("#btnShowAddPhone").click(function () { $("#frmAddPhone").toggle(); });
        $("#btnShowAddEmail").click(function () { $("#frmAddEmail").toggle(); });
        $("#btnNewPhoneSave").click(function () { alert("Numero di telefono aggiunto"); });
        $("#btnNewMailSave").click(function () { alert("Email aggiunta"); });
    });
</script>