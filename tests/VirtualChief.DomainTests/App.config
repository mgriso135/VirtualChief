<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!--
      Mirrors Web.config appSettings keys so the typed config reader
      (App_Sources/AppConfig.cs) can be exercised: env vars (VC_*) override,
      these are the fallback values.
    -->
    <add key="smtpUsername" value="test-smtp@example.test" />
    <add key="smtpPassword" value="test-smtp-pass" />
    <add key="auth0:ClientId" value="test-auth0-client" />
    <add key="auth0:Domain" value="test.eu.auth0.com" />
  </appSettings>
  <connectionStrings>
    <!--
      Points the legacy business classes (which build tenant connection strings via
      Dati.GetConnectionString by replacing "database=") at the private MariaDB
      provisioned by tests/provision-db.sh. Override via VC_DB_* by editing here.
    -->
    <add name="masterDB" connectionString="server=127.0.0.1;port=3307;user id=vc;password=vc;database=;pooling=true" />
    <add name="vcmain" connectionString="server=127.0.0.1;port=3307;user id=vc;password=vc;database=vcmain;pooling=true" />
  </connectionStrings>
</configuration>
