        </td>
    </tr>
    <tr style="display:none;">
        <td><label id="lblTipoDiagramma" /><label id="lblTipoDiagramma2" />:</td>
        <td style="font-size: 16px;">
            <label id="vsm" />
            <select id="inputVSM">
                <option value="1"></option>
                <option value="0"></option>
            </select>
        </td>
        <td rowspan="3">
        </td>
    </tr>
    <tr>
        <td colspan="2">
            <button type="button" id="imgEdit" class="btn-link" onclick="toggleEdit()"><img src="~/img/edit.png" width="50" title="Modifica" /></button>
            <button type="button" id="imgDeleteProcess" class="btn-link" onclick="doDeleteProcess()"><img src="~/img/iconDelete.png" width="50" title="Elimina processo" /></button>
            <button type="button" id="imgSave" class="btn-link" onclick="doSave()"><img src="~/img/iconSave.jpg" width="50" title="Salva le modifiche" /></button>
            <button type="button" id="imgCancel" class="btn-link" onclick="toggleEdit()"><img src="~/img/iconCancel.jpg" width="50" title="Non salvare le modifiche" /></button>
        </td></tr>
</table>
<br />
