@page
@model VirtualChief.Pages.ErrorModel
@{
    ViewData["Title"] = Model.Title;
}
<div class="container mt-4">
    <div class="alert @(Model.WorkspaceUnavailable ? "alert-warning" : "alert-danger")" role="alert">
        <h1 class="h3">@Model.Title</h1>
        <p class="mb-0">@Model.Message</p>
    </div>
    <a class="btn btn-primary" asp-page="/Login/selectWorkspace">Cambia workspace</a>
    <a class="btn btn-secondary" asp-page="/Index">Home</a>
</div>
