<?xml version="1.0" encoding="utf-8"?>
<!--
  Fallback configuration for the legacy KIS.App_Code.Secrets seam.
  Environment variables (VC_*) always take precedence over these values.
  These defaults point at the provisioned characterization database
  (tests/provision-db.sh): MariaDB on 127.0.0.1:3307, user vc/vc.
-->
<configuration>
  <configSections>
    <!-- Legacy KanbanBox by Sintesia module configuration (KisWebApp/Web.config) -->
    <section name="kanbanBox" type="KIS.App_Code.KanbanBoxConfig, KisApp.App_Sources" allowLocation="true" allowDefinition="Everywhere"/>
  </configSections>
  <appSettings>
    <!-- SMTP credentials used by KIS.App_Code.Secrets (env vars VC_SMTP_USER/VC_SMTP_PASS win) -->
    <add key="smtpUsername" value=""/>
    <add key="smtpPassword" value=""/>
  </appSettings>
  <connectionStrings>
    <!-- Tenant master string: 'database=' is swapped per workspace at runtime -->
    <add name="masterDB" connectionString="Server=127.0.0.1;Port=3307;Uid=vc;Pwd=vc;database=" />
    <!-- Central multi-tenant DB (accounts, workspaces, menu tree) -->
    <add name="vcmain" connectionString="Server=127.0.0.1;Port=3307;Uid=vc;Pwd=vc;Database=vcmain" />
  </connectionStrings>
  <kanbanBox kanbanBoxEnabled="false" version="0" x-api-key=""/>
</configuration>
