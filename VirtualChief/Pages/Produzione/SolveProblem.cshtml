@page "/Produzione/SolveProblem"
@model VirtualChief.Pages.Produzione.SolveProblemModel
@{
    ViewData["Title"] = "Risolvi Problema";
}

<div class="container">
    <nav aria-label="breadcrumb" class="mt-3 mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="/Produzione/produzione">@Model.NavProduzione</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">@Model.NavSolveProblem</li>
        </ol>
    </nav>

    <h1>@Model.NavSolveProblem</h1>

    <div class="card">
        <div class="card-body">
            @if (Model.HasPermission && Model.IdWarning > 0)
            {
                <component type="typeof(Components.Produzione.FrmSolveProblem)" 
                           param-Tenant="@Model.Tenant"
                           param-HasPermission="@Model.HasPermission"
                           param-IdWarning="@Model.IdWarning"
                           render-mode="ServerPrerendered" />
            }
            else
            {
                <div class="alert alert-warning">@Model.ErrorMessage</div>
            }
             
            @if (!string.IsNullOrEmpty(Model.ErrorMessage) && Model.HasPermission)
            {
                <div class="alert alert-danger mt-3">@Model.ErrorMessage</div>
            }
        </div>
    </div>
</div>