@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService Authorization
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Virtual Chief</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-3">
        <div class="container-fluid">
            <a class="navbar-brand" asp-page="/Index">Virtual Chief</a>
            @{
                var menu = CurrentWorkspace.Of(User) != null ? UserMenu.Build(User) : new List<MenuItem>();
            }
            <ul class="navbar-nav me-auto">
                @foreach (var item in menu)
                {
                    if (item.Children.Count > 0)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="menu-@item.Title.Replace(" ", "")"
                               role="button" data-bs-toggle="dropdown" aria-expanded="false">@item.Title</a>
                            <ul class="dropdown-menu" aria-labelledby="menu-@item.Title.Replace(" ", "")">
                                @foreach (var child in item.Children)
                                {
                                    <li><a class="dropdown-item" href="@child.Url">@child.Title</a></li>
                                }
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" href="@item.Url">@item.Title</a></li>
                    }
                }
            </ul>
            <ul class="navbar-nav">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    var ws = CurrentWorkspace.Of(User);
                    <li class="nav-item">
                        <span class="navbar-text text-info me-3">
                            @User.Identity.Name @(string.IsNullOrEmpty(ws) ? "" : $"@ {ws}")
                        </span>
                    </li>
                    <li class="nav-item"><a class="nav-link" asp-page="/Login/selectWorkspace">Cambia workspace</a></li>
                    <li class="nav-item">
                        <form method="post" asp-page="/Login/login" asp-page-handler="Logout" class="d-inline">
                            <button type="submit" class="btn btn-outline-light btn-sm">Esci</button>
                        </form>
                    </li>
                }
                else
                {
                    <li class="nav-item"><a class="nav-link" asp-page="/Login/login">Accedi</a></li>
                }
            </ul>
        </div>
    </nav>
    <main class="container">
        @RenderBody()
    </main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
