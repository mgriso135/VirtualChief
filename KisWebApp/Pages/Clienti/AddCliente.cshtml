@page
@model KisWebApp.Pages.Clienti.AddClienteModel
@{
    ViewData["Title"] = "Add Client";
}

<div class="container">
    <h1>Add Client</h1>
    
    @if (Model.Client != null)
    {
        <form method="post">
            <div class="form-group">
                <label>Name</label>
                <input type="text" class="form-control" id="Name" name="Name" value="@Model.Client.Name" required>
            </div>
            <div class="form-group">
                <label>Contact</label>
                <input type="text" class="form-control" id="Contact" name="Contact" value="@Model.Client.Contact" required>
            </div>
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-page="Clienti" class="btn btn-secondary">Cancel</a>
        </form>
    }
    else
    {
        <p>Permission denied</p>
    }
</div>